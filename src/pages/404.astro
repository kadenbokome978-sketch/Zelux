---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Zelux" description="This page doesn't exist. Head back to Zelux or book a 20-minute call." noindex>
  <section class="container-z flex min-h-[70svh] flex-col justify-center py-24">
    <p class="eyebrow"><span class="text-brass">404</span><span class="mx-2 text-hairline">/</span>Not found</p>
    <h1 class="h-display mt-6 max-w-[16ch]">This page <em class="italic text-brass">doesn't exist.</em></h1>
    <p class="lead mt-6 max-w-[44ch]">The link may be old, or mistyped. Everything that matters is a click away.</p>
    <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3">
      <a href="/" class="btn-primary">Back to home <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/book" class="btn-ghost">Book a call</a>
    </div>
  </section>
</Base>
