---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseCard from '../components/CaseCard.astro';
import ClosingBand from '../components/ClosingBand.astro';
import work from '../content/work.json';
---
<Base
  title="Work — Case Studies | Zelux"
  description="Websites and systems built by Zelux. Every case study is published only once a project is live and the client has approved it. No invented logos or stats."
>
  <section class="container-z pb-16 pt-14 md:pb-24 md:pt-20">
    <SectionHead as="h1" eyebrow="Work" title="Real projects." italic="Real permission." intro="Each entry follows the same structure: the friction, what was built, and the outcome. Reserved slots fill as client projects launch and sign-off lands." />
    <div class="mt-16 grid gap-5 md:mt-20 md:grid-cols-3">
      {work.map((w, i) => <CaseCard item={w} delay={i * 90} />)}
    </div>
    <p class="mt-10 max-w-[60ch] text-sm text-ink-3" data-reveal>
      Want to see work in progress? Live previews of current builds are <a href="/book" class="text-ink underline decoration-hairline-accent underline-offset-4 hover:decoration-brass">available for review on request</a>.
    </p>
  </section>
  <ClosingBand />
</Base>
