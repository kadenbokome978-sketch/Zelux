---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ClosingBand from '../components/ClosingBand.astro';
import services from '../content/services.json';
import automations from '../content/automations.json';
import { icons } from '../content/icons';
const serviceIcon: Record<string, string> = { websites: 'website', automation: 'cog', care: 'care' };
---
<Base
  title="Services: Websites, Automation & Care | Zelux"
  description="Websites that bring in work, workflow automation, and ongoing care for UK businesses. Clear scope, what's included, what isn't, and a fixed price."
>
  <section class="first-screen container-z pb-8 pt-8 md:pb-16 md:pt-20">
    <SectionHead as="h1" eyebrow="Services" title="What I build," italic="and what I don't." intro="Three focused services, written the way the contract reads: what's included, what isn't, and how long it takes." />
    <nav aria-label="Services on this page" class="mt-8 flex flex-wrap gap-2 sm:mt-10" data-reveal>
      {services.map((s) => (
        <a href={`#${s.slug}`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-hairline bg-paper px-3.5 text-[0.8125rem] font-medium text-ink transition-colors hover:border-accent hover:text-accent sm:gap-2.5 sm:px-4 sm:text-sm">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[serviceIcon[s.slug]]} /></svg>{s.title}
        </a>
      ))}
      <a href="#automations" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-hairline bg-paper px-3.5 text-[0.8125rem] font-medium text-ink transition-colors hover:border-accent hover:text-accent sm:gap-2.5 sm:px-4 sm:text-sm">
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" /></svg>The ten automations
      </a>
    </nav>
  </section>

  <div class="container-z grid gap-6 pb-16 md:pb-20">
    {services.map((s, i) => (
      <section id={s.slug} class="scroll-mt-20 overflow-hidden rounded-[calc(var(--radius-card)+0.5rem)] border border-hairline bg-paper" data-reveal>
        <div class="grid lg:grid-cols-12">
          <div class:list={['p-6 md:p-10 lg:col-span-6', 'bg-surface']}>
            <span class:list={['grid h-14 w-14 place-items-center rounded-[16px]', 'bg-accent text-on-accent']}>
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[serviceIcon[s.slug]]} /></svg>
            </span>
            <p class="mt-6 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent-hover">{s.index} · Fixed price · quoted within 48 hours</p>
            <h2 class="h-section mt-2">{s.title}</h2>
            <p class:list={['mt-4 text-[1.0625rem] leading-relaxed', 'text-ink-2']}>{s.summary}</p>
            <div class:list={['mt-6 rounded-inner p-4', 'bg-paper']}>
              <p class:list={['font-mono text-[0.6875rem] uppercase tracking-[0.12em]', 'text-accent-hover']}>Best if</p>
              <p class:list={['mt-1.5 text-[0.9375rem] leading-relaxed', 'text-ink']}>{s.bestFor}</p>
            </div>
            <p class:list={['mt-6 text-sm', 'text-ink-2']}><strong class:list={['text-ink']}>Timeline:</strong> {s.timeline}</p>
          </div>
          <details class="svc-more lg:col-span-6" open>
          <summary class="svc-sum">What's included, and what isn't<span aria-hidden="true">+</span></summary>
          <div class="grid content-start gap-6 p-6 pt-2 md:p-10 lg:pt-10">
            <div>
              <h3 class="text-[1.0625rem] font-semibold text-ink">What's included</h3>
              <ul class="mt-4 grid gap-3">
                {s.included.map((x) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink-2">
                    <svg class="mt-1 shrink-0 text-accent" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{x}
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-inner bg-surface p-5">
              <h3 class="text-[0.9375rem] font-semibold text-ink">Not included</h3>
              <ul class="mt-3 grid gap-2.5">
                {s.notIncluded.map((x) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink-2">
                    <svg class="mt-1 shrink-0 text-ink-3" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>{x}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          </details>
        </div>
      </section>
    ))}
  </div>

  <section id="automations" class="scroll-mt-16 border-t border-hairline bg-surface">
    <div class="container-z py-12 md:py-20">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end" data-reveal>
        <h2 class="h-section lg:col-span-7">Ten ways to get hours back.</h2>
        <p class="body lg:col-span-5">Each one is set up around the tools you already use, tested with real examples, and handed over with plain‑English notes.</p>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-2.5 sm:mt-10 sm:gap-3 lg:grid-cols-5">
        {automations.map((a) => (
          <li id={`auto-${a.index}`} class="scroll-mt-20" data-reveal>
            <a href={`/automations/${a.slug}`} class="group flex h-full flex-col gap-2.5 rounded-card border border-hairline bg-paper p-4 sm:gap-3 sm:p-5 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent">
              <span class="grid h-10 w-10 place-items-center rounded-[12px] bg-accent-tint sm:h-12 sm:w-12 sm:rounded-[14px] text-accent-hover transition-colors group-hover:bg-accent group-hover:text-on-accent">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[a.icon]} /></svg>
              </span>
              <span class="text-[0.9375rem] font-semibold leading-snug tracking-[-0.015em] text-ink sm:text-[1.0625rem]">{a.title}</span>
              <span class="hidden text-[0.875rem] leading-relaxed text-ink-2 sm:block">{(a.body.split('. ')[0].length < 40 ? a.body.split('. ').slice(0, 2).join('. ') : a.body.split('. ')[0]).replace(/\.$/, '')}.</span>
              <span class="mt-auto text-[0.8125rem] font-semibold text-accent sm:text-sm">How it works →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClosingBand />
  <style>
    .svc-sum { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 1.5rem; font-weight: 600; color: var(--color-ink); cursor: pointer; list-style: none; border-top: 1px solid var(--color-hairline); }
    .svc-sum::-webkit-details-marker { display: none; }
    .svc-sum span { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 999px; border: 1px solid var(--color-hairline); color: var(--color-accent); transition: transform var(--dur-ui) var(--ease-out-soft); }
    .svc-more[open] .svc-sum span { transform: rotate(45deg); }
    @media (min-width: 1024px) { .svc-sum { display: none; } }
  </style>
  <script>
    // Phones: start the long lists folded away. Desktop (and no JS): always open.
    const mq = matchMedia('(min-width: 1024px)');
    const set = () => document.querySelectorAll<HTMLDetailsElement>('.svc-more').forEach((d) => (d.open = mq.matches || location.hash === `#${d.closest('section')?.id}`));
    set();
    mq.addEventListener('change', set);
  </script>
</Base>
