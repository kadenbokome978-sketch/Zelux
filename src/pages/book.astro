---
import Base from '../layouts/Base.astro';
import site from '../content/site.json';

const calLink = String(import.meta.env.PUBLIC_CAL_LINK || site.calLink || '').trim();
// Only show the calendar for a real Cal.com link. 'none' or empty = hidden (the old link pointed at someone else's account).
const hasCal = calLink !== '' && calLink !== 'none';
const web3Key = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
// Without JS the form still posts: to Web3Forms when a key is set, otherwise it opens an email.
const formAction = web3Key ? 'https://api.web3forms.com/submit' : `mailto:${site.email}?subject=${encodeURIComponent('Enquiry from zelux.co.uk')}`;
const agenda = [
  'Your current bottleneck: what\'s costing you time or leads',
  'What a lean build would look like for you',
  'Rough cost and timeline, said plainly',
];
---
<Base
  title="Book a 20-Minute Intro Call | Zelux"
  description="Book a free 20-minute call with Kaden at Zelux to talk through your website or automation project, or send a short enquiry. Reply within one working day."
>
  <section class="container-z pb-20 pt-16 md:pb-28 md:pt-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Booking -->
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Book a call</p>
        <h1 class="h-section mt-6 !text-[clamp(2.25rem,4vw,3.25rem)]" data-reveal style="--d:80ms">Book a free <span class="whitespace-nowrap">20-min</span> call.</h1>
        <p class="lead mt-4 max-w-[48ch]" data-reveal style="--d:120ms">Video or phone, whichever suits. No pitch deck, and no obligation.</p>
        <p class="mt-8 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3" data-reveal style="--d:160ms">On the call</p>
        <ul class="mt-3 border-t border-hairline" data-reveal style="--d:160ms">
          {agenda.map((a) => (
            <li class="flex items-center gap-4 border-b border-hairline py-4 text-ink-2">
              <span class="h-px w-4 shrink-0 bg-accent" aria-hidden="true"></span>{a}
            </li>
          ))}
        </ul>

        {hasCal ? (
        <div class="panel mt-10 overflow-hidden" data-reveal style="--d:200ms">
          <div class="flex items-center justify-between border-b border-hairline px-4 py-3">
            <span class="eyebrow !text-[0.6875rem]">Calendar · 20 min · Video call</span>
            <a href={`https://cal.com/${calLink}`} target="_blank" rel="noopener" class="link-u font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-2 hover:text-ink">Open in new tab ↗</a>
          </div>
          <div id="cal-inline" class="min-h-[560px] w-full" data-cal-link={calLink}>
            <div id="cal-fallback" class="flex min-h-[560px] flex-col items-center justify-center gap-4 p-8 text-center">
              <span class="h-6 w-6 animate-spin rounded-full border border-hairline border-t-accent motion-reduce:animate-none" aria-hidden="true"></span>
              <p class="text-sm text-ink-3">Loading calendar…</p>
              <a href={`https://cal.com/${calLink}`} target="_blank" rel="noopener" class="btn-ghost text-sm">Calendar not loading? Open booking page ↗</a>
            </div>
          </div>
        </div>
        ) : (
          <div class="mt-10 rounded-card border border-hairline bg-paper p-6 md:p-8" data-reveal style="--d:200ms">
            <h2 class="font-serif text-[1.5rem] leading-tight text-ink">How booking works</h2>
            <ol class="mt-5 grid gap-4">
              {[
                ['Send a short note', `Use the form, or email ${site.email}. A couple of lines is plenty.`],
                ['I reply within one working day', 'With two or three times that suit, by video or phone.'],
                ['20 minutes, no pitch', 'You leave knowing what a build would cost and how long it would take.'],
              ].map(([t, b], i) => (
                <li class="flex gap-4">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-tint font-mono text-xs font-semibold text-accent-hover">{i + 1}</span>
                  <span><strong class="block font-semibold text-ink">{t}</strong><span class="text-[0.9375rem] text-ink-2">{b}</span></span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <!-- Enquiry form -->
      <aside class="lg:col-span-5" data-reveal style="--d:240ms">
        <div id="enquiry" class="panel p-6 md:p-8 lg:sticky lg:top-24">
          <h2 class="font-serif text-[2rem] leading-tight text-ink">{hasCal ? 'Prefer to write first?' : 'Tell me what you need'}</h2>
          <p class="body mt-3 text-[0.9375rem]">Send a short note. I reply personally, usually within one working day.</p>

          <form id="enquiry-form" class="mt-8 grid gap-5" method="post" action={formAction} enctype={web3Key ? undefined : 'text/plain'} data-key={web3Key}>
            {web3Key && <input type="hidden" name="access_key" value={web3Key} />}
            <input type="hidden" name="subject" value="New enquiry from zelux.co.uk" />
            <input type="hidden" name="from_name" value="Zelux website" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="grid gap-2">
              <label for="f-name" class="text-sm text-ink">Name</label>
              <input id="f-name" name="name" class="field" autocomplete="name" placeholder="Sam Taylor" required aria-describedby="f-name-err" />
              <p id="f-name-err" class="field-error hidden">Please add your name.</p>
            </div>
            <div class="grid gap-2">
              <label for="f-email" class="text-sm text-ink">Email</label>
              <input id="f-email" name="email" type="email" class="field" autocomplete="email" inputmode="email" placeholder="sam@yourbusiness.co.uk" required aria-describedby="f-email-err" />
              <p id="f-email-err" class="field-error hidden">Please add an email address I can reply to, like name@business.co.uk.</p>
            </div>
            <div class="grid gap-2">
              <label for="f-biz" class="text-sm text-ink">Business / website <span class="text-ink-3">(optional)</span></label>
              <input id="f-biz" name="business" class="field" autocomplete="organization" placeholder="yourbusiness.co.uk" />
            </div>
            <div class="grid gap-2">
              <label for="f-msg" class="text-sm text-ink">What are you looking to build or fix?</label>
              <textarea id="f-msg" name="message" rows="4" class="field resize-y" required aria-describedby="f-msg-err"></textarea>
              <p id="f-msg-err" class="field-error hidden">A line or two is plenty. What would you like built or fixed?</p>
            </div>

            <p id="form-status" class="hidden rounded-inner border px-4 py-3 text-sm" role="status" aria-live="polite"></p>

            <button type="submit" class="btn-primary w-full disabled:cursor-wait disabled:opacity-60">
              <span class="label">Send enquiry</span> <span class="arrow" aria-hidden="true">→</span>
            </button>
            <p class="text-xs leading-relaxed text-ink-3">
              Your details are only used to reply to you. See the <a href="/privacy" class="underline underline-offset-2 hover:text-ink">privacy policy</a>.
              {hasCal && <>Or email <a href={`mailto:${site.email}`} class="text-ink-2 underline underline-offset-2 hover:text-ink">{site.email}</a>.</>}
            </p>
          </form>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // ---- Cal.com inline embed (loaded only on this page) ----
  const host = document.getElementById('cal-inline');
  const calLink = host?.dataset.calLink;
  if (host && calLink) {
    // Official Cal.com loader snippet
    (function (C: any, A: string, L: string) {
      const p = function (a: any, ar: any) { a.q.push(ar); };
      const d = C.document;
      C.Cal = C.Cal || function () {
        const cal = C.Cal; const ar = arguments;
        if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
        if (ar[0] === L) {
          const api: any = function () { p(api, arguments); };
          const namespace = ar[1]; api.q = api.q || [];
          if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    const Cal = (window as any).Cal;
    Cal('init', 'zelux', { origin: 'https://cal.com' });
    Cal.ns.zelux('inline', {
      elementOrSelector: '#cal-inline',
      calLink,
      config: { layout: 'month_view', theme: 'light', useSlotsViewOnSmallScreen: 'true' },
    });
    Cal.ns.zelux('ui', {
      theme: 'light',
      hideEventTypeDetails: false,
      layout: 'month_view',
      cssVarsPerTheme: { light: { 'cal-brand': '#2563EB', 'cal-brand-text': '#F8FAFC', 'cal-bg': '#FCFDFF', 'cal-bg-muted': '#F8FAFC', 'cal-border': '#DDE3EB' } },
    });
    Cal.ns.zelux('on', {
      action: 'linkReady',
      callback: () => document.getElementById('cal-fallback')?.remove(),
    });
    // If blocked (privacy extensions etc.), make the fallback obvious.
    setTimeout(() => {
      const fb = document.getElementById('cal-fallback');
      if (fb) fb.querySelector('p')!.textContent = 'The calendar is taking a while (an ad or privacy blocker may be stopping it).';
    }, 8000);
  }

  // ---- Web3Forms enquiry ----
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status')!;
  const show = (msg: string, ok: boolean) => {
    status.textContent = msg;
    status.className = `rounded-inner border px-4 py-3 text-sm ${ok ? 'border-[#9cc9ae] text-[#1d5c3a] bg-[#e9f4ec]' : 'border-[#e2a49f] text-[#8c1d17] bg-[#fbeceb]'}`;
  };
  // Prefill from the homepage time-saver (?need=...)
  const need = new URLSearchParams(location.search).get('need');
  const msgField = document.getElementById('f-msg') as HTMLTextAreaElement | null;
  if (need && msgField && !msgField.value) msgField.value = need.slice(0, 600);

  // JS takes over validation so each field gets its own message.
  if (form) form.noValidate = true;
  const fields = form ? Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) : [];
  const mark = (f: HTMLInputElement | HTMLTextAreaElement) => {
    const ok = f.validity.valid;
    f.setAttribute('aria-invalid', String(!ok));
    document.getElementById(`${f.id}-err`)?.classList.toggle('hidden', ok);
    return ok;
  };
  fields.forEach((f) => {
    f.addEventListener('blur', () => { if (f.value) mark(f); });
    f.addEventListener('input', () => { if (f.getAttribute('aria-invalid') === 'true') mark(f); });
  });
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bad = fields.filter((f) => !mark(f));
    if (bad.length) {
      bad[0].focus();
      show(bad.length === 1 ? 'One field needs a quick fix, marked above.' : `${bad.length} fields need a quick fix, marked above.`, false);
      return;
    }
    const key = form.dataset.key;
    if (!key) {
      // No form service yet: hand the message to the visitor's email app, ready to send.
      const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() || '';
      const body = `Name: ${v('name')}\nEmail: ${v('email')}\nBusiness: ${v('business') || '-'}\n\n${v('message')}`;
      window.location.href = `mailto:kaden@zelux.co.uk?subject=${encodeURIComponent('Enquiry from zelux.co.uk')}&body=${encodeURIComponent(body)}`;
      show('Your email app should open with your message ready to send. If it doesn\'t, email kaden@zelux.co.uk.', true);
      return;
    }
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const label = btn.querySelector('.label')!;
    btn.disabled = true; label.textContent = 'Sending…';
    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: data });
      const json = await res.json();
      if (json.success) {
        form.reset();
        fields.forEach((f) => f.removeAttribute('aria-invalid'));
        show('Thanks, that\'s landed. I\'ll reply personally, usually within one working day.', true);
      } else throw new Error(json.message);
    } catch {
      show('Something went wrong sending that. Please email kaden@zelux.co.uk instead.', false);
    } finally {
      btn.disabled = false; label.textContent = 'Send enquiry';
    }
  });
</script>
