---
// One page per automation, generated from automations.json + blueprints.json.
// Written for people (and search): what it is, how it runs, where you stay in control, what it costs, next step.
import Base from '../../layouts/Base.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import automations from '../../content/automations.json';
import blueprints from '../../content/blueprints.json';
import site from '../../content/site.json';
import { icons } from '../../content/icons';
import Faq from '../../components/Faq.astro';

export function getStaticPaths() {
  return automations.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const a = automations.find((x) => x.slug === slug)!;
const bp = blueprints.find((b) => b.auto === a.index);
const toolLabel: Record<string, string> = {
  email: 'Gmail / Outlook', calendar: 'Google / Outlook Calendar', sheets: 'Sheets / Excel', accounts: 'Xero / QuickBooks',
  payments: 'Stripe / SumUp', shop: 'Shopify / WooCommerce', social: 'Facebook / Instagram', sms: 'Text / WhatsApp',
  crm: 'A CRM', website: 'Your website',
};
// Hand-picked pairings: automations that genuinely share a workflow
const pairs: Record<string, string[]> = {
  '01': ['02', '04', '07'], '02': ['05', '01', '06'], '03': ['07', '10', '01'], '04': ['05', '07', '10'], '05': ['02', '07', '04'],
  '06': ['02', '05', '09'], '07': ['05', '04', '03'], '08': ['09', '10', '03'], '09': ['08', '07', '06'], '10': ['04', '08', '03'],
};
const related = pairs[a.index].map((n) => automations.find((x) => x.index === n)!);
const need = `I'd like to set up ${a.title.toLowerCase()}.`;
const faqs: [string, string][] = [
  ['How long does it take to set up?', 'Most focused automations are live within 1–2 weeks, tested with real examples from your business first.'],
  ['What does it cost?', 'A fixed price, quoted within 48 hours of a free 20-minute call. No day rates, and no VAT on top because Zelux isn’t VAT registered.'],
  ['Do I need new software?', 'Usually not. It’s built around the tools you already use. Any licences stay in your name, at your cost, so nothing is locked to me.'],
  ['What if something goes wrong?', 'You get plain-English notes on what runs and when, and anything that speaks for you waits for your approval until you say otherwise.'],
];
---
<Base
  title={`${a.seoTitle} for Small Businesses | Zelux`}
  description={`${a.body.split('. ')[0]}. Set up around the tools you already use, at a fixed price. Hampshire, UK.`}
>
  <section class="container-z pb-12 pt-12 md:pb-16 md:pt-16">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-3" data-reveal>
      <a href="/services" class="link-u hover:text-ink">Services</a> <span aria-hidden="true">/</span> <a href="/services#automations" class="link-u hover:text-ink">Automations</a> <span aria-hidden="true">/</span> <span class="text-ink" aria-current="page">{a.title}</span>
    </nav>
    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-7" data-reveal>
        <span class="grid h-16 w-16 place-items-center rounded-[18px] bg-accent text-on-accent">
          <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[a.icon]} /></svg>
        </span>
        <h1 class="h-hero mt-6 !max-w-[16ch]">{a.title}</h1>
        <p class="lead mt-6 max-w-[54ch]">{a.body}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={`/book?need=${encodeURIComponent(need)}#enquiry`} class="btn-primary btn-lg">Get this built <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/services#automations" class="btn-ghost">See all ten automations</a>
        </div>
      </div>
      {bp && (
        <aside id="how" class="scroll-mt-20 lg:col-span-5" data-reveal style="--d:80ms" aria-label="How it runs">
          <div class="at rounded-[calc(var(--radius-card)+0.25rem)] bg-deep p-6 text-deep-ink md:p-7">
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent-on-deep">How it runs</p>
            <ol class="at-list mt-6">
              <li class="at-step at-trigger" style="--n:0"><span class="at-dot" aria-hidden="true"></span><span><span class="at-k">Starts when</span>{bp.trigger}</span></li>
              {bp.steps.map((st, n) => (
                <li class="at-step" style={`--n:${n + 1}`}><span class="at-dot" aria-hidden="true"></span><span>{st}</span></li>
              ))}
            </ol>
            <p class="mt-5 flex gap-3 rounded-inner bg-deep-2 p-4 text-[0.9375rem] leading-relaxed text-deep-ink-2">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="#4ade80" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.4 3 8.1 7 9.5 4-1.4 7-5.1 7-9.5V6l-7-3Zm-3 9 2 2 4-4" /></svg>
              <span><strong class="text-deep-ink">You stay in control.</strong> {bp.approve}</span>
            </p>
            <p class="mt-5 flex flex-wrap items-center gap-2 text-sm"><span class="mr-1 text-deep-ink-2">Works with</span>{bp.tools.map((t) => <span class="rounded-full border border-deep-line px-3 py-1 text-deep-ink">{toolLabel[t]}</span>)}</p>
          </div>
        </aside>
      )}
    </div>
  </section>


  <section class="border-t border-hairline">
    <div class="container-z grid gap-8 py-14 md:grid-cols-12 md:py-20">
      <h2 class="h-section md:col-span-4" data-reveal>Common questions</h2>
      <div class="md:col-span-8"><Faq items={faqs.map(([q, ans]) => ({ q, a: ans }))} /></div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="container-z py-14 md:py-16">
      <h2 class="font-serif text-[1.625rem] text-ink" data-reveal>Often set up alongside</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3" data-reveal style="--d:60ms">
        {related.map((r) => (
          <li>
            <a href={`/automations/${r.slug}`} class="group flex h-full items-center gap-4 rounded-card border border-hairline bg-paper p-5 transition-colors hover:border-accent">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[14px] bg-accent-tint text-accent-hover">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[r.icon]} /></svg>
              </span>
              <span class="font-semibold text-ink group-hover:text-accent">{r.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClosingBand />
</Base>

<style>
  .at-list { position: relative; display: grid; gap: 0.9rem; padding: 0; list-style: none; }
  .at-list::before { content: ''; position: absolute; left: 7px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: var(--color-deep-line); }
  .at-step { position: relative; display: flex; gap: 1rem; font-size: 0.9375rem; line-height: 1.45; color: var(--color-deep-ink); }
  .at-k { display: block; margin-bottom: 0.15rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-deep-ink-2); }
  .at-trigger { font-family: var(--font-serif); font-size: 1.125rem; }
  .at-dot { position: relative; z-index: 1; flex: none; width: 16px; height: 16px; margin-top: 2px; border-radius: 999px; border: 2px solid var(--color-accent-on-deep); background: var(--color-accent-on-deep); }
  .at-trigger .at-dot { margin-top: 1.25rem; }
  /* Plays once as the card comes into view (reveal.ts adds .is-in); static with reduced motion or no JS */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .at-step { opacity: 0.35; }
    :global(.reveal-ready .is-in) .at-step { animation: at-on 450ms var(--ease-out-soft) calc(var(--n) * 450ms + 250ms) both; }
    :global(.reveal-ready .is-in) .at-dot { animation: at-dot 450ms var(--ease-out-soft) calc(var(--n) * 450ms + 250ms) both; }
  }
  @keyframes at-on { from { opacity: 0.35; } to { opacity: 1; } }
  @keyframes at-dot { from { background: var(--color-deep); } to { background: var(--color-accent-on-deep); } }
</style>
