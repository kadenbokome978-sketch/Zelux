---
import Base from '../layouts/Base.astro';
import LeadFlow from '../components/LeadFlow.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import Detector from '../components/Detector.astro';
import Faq from '../components/Faq.astro';
import ClosingBand from '../components/ClosingBand.astro';
import site from '../content/site.json';
import services from '../content/services.json';

const pricing = site.pricing.mode === 'guide' ? site.pricing.guide : site.pricing.fixedQuote;
---
<Base
  title="Zelux: Websites & Business Systems | UK Studio"
  description="Bespoke websites, workflow automation and connected business systems for UK businesses. Direct with Kaden Ekuma Bokome. Book a 20-minute intro call."
>
  <!-- HERO -->
  <section class="hero-grid relative">
    <div class="container-z pb-10 pt-10 md:pb-14 md:pt-16">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3" data-reveal>
        <p class="eyebrow">{site.hero.eyebrow}</p>
        <p class="flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-2">
          <span class="h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>{site.hero.status}
        </p>
      </div>
      <h1 class="h-hero mt-8 md:mt-10" data-reveal style="--d:80ms">
        {site.hero.titleLead} <em class="text-accent">{site.hero.titleItalic}</em>
      </h1>
      <div class="mt-8 grid gap-8 md:mt-12 md:grid-cols-12 md:items-end" data-reveal style="--d:160ms">
        <p class="lead max-w-[52ch] md:col-span-7">{site.hero.subtitle}</p>
        <div class="flex flex-wrap items-center gap-x-7 gap-y-2 md:col-span-5 md:justify-end">
          <a href="/book" class="btn-primary btn-lg">Book a free 20-min call <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#time-saver" class="btn-ghost">Find what to automate ↓</a>
        </div>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-hairline pt-5 text-[0.9375rem] font-medium text-ink" data-reveal style="--d:200ms">
        {site.speed.map((t) => (
          <li class="flex items-center gap-2.5"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="text-accent"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{t}</li>
        ))}
      </ul>
      <div class="mt-12 md:mt-16" data-reveal style="--d:240ms">
        <LeadFlow />
      </div>
    </div>
  </section>

  <!-- STATEMENT (accent band) -->
  <section class="band-deep">
    <div class="container-z grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="h-statement">You speak to the person who builds it.</h2>
        <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-deep-ink-2">{site.pillars[0].body}</p>
      </div>
      <div class="self-end lg:col-span-5" data-reveal style="--d:90ms">
        <h3 class="text-[1.375rem] font-medium tracking-[-0.02em]">{site.promises.title}</h3>
        <ul class="mt-4 divide-y divide-deep-line border-y border-deep-line">
          {site.promises.items.map((t) => (
            <li class="flex gap-3 py-3 text-[0.9375rem] leading-relaxed text-deep-ink-2">
              <svg class="mt-1 shrink-0 text-accent-on-deep" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- TIME-SAVER DETECTOR -->
  <section id="time-saver" class="scroll-mt-16 border-b border-hairline bg-surface">
    <div class="container-z py-16 md:py-24">
      <div class="max-w-[46rem]" data-reveal>
        <p class="eyebrow">Try it</p>
        <h2 class="h-section mt-4">What should stop <em class="text-accent">taking your time?</em></h2>
        <p class="body mt-4">Pick the jobs that eat your week. You'll get a plain blueprint for each one: what starts it, what happens, and where you stay in control. <a href="/services#automations" class="text-ink underline decoration-hairline-strong underline-offset-4 hover:text-accent">See all ten automations</a>.</p>
      </div>
      <div class="mt-10 md:mt-12" data-reveal style="--d:90ms"><Detector /></div>
    </div>
  </section>

  <!-- VALUE: time / money / revenue -->
  <section class="border-b border-hairline">
    <div class="container-z py-16 md:py-24">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <h2 class="h-section lg:col-span-7">{site.value.title} <em class="text-accent">{site.value.titleAccent}</em></h2>
        <p class="body lg:col-span-5">{site.value.intro}</p>
      </div>
      <div class="mt-10 grid gap-5 md:mt-12 lg:grid-cols-3">
        {site.value.groups.map((g, gi) => (
          <div class="panel flex flex-col bg-white p-6 md:p-7" data-reveal style={`--d:${gi * 90}ms`}>
            <p class="inline-flex self-start rounded-[2px] bg-accent-tint px-2.5 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent-hover">{g.label}</p>
            <ul class="mt-5 divide-y divide-hairline">
              {g.points.map((pt) => (
                <li class="py-4 first:pt-0 last:pb-0">
                  <h3 class="text-[1.0625rem] font-semibold leading-snug tracking-[-0.01em] text-ink">{pt.t}</h3>
                  <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-2">{pt.b}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-5 grid items-center gap-5 rounded-[2px] border border-accent bg-white p-6 md:grid-cols-12 md:p-7" data-reveal>
        <div class="flex items-center gap-4 md:col-span-5">
          <span class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-full bg-accent text-white" aria-hidden="true">
            <span class="text-[1.375rem] font-semibold leading-none">7</span><span class="font-mono text-[0.5625rem] uppercase tracking-[0.12em]">days</span>
          </span>
          <div>
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent">{site.guarantee.title}</p>
            <h3 class="mt-1 text-[1.5rem] font-semibold leading-tight tracking-[-0.025em] text-ink">{site.guarantee.short}</h3>
          </div>
        </div>
        <p class="text-[0.9375rem] leading-relaxed text-ink-2 md:col-span-7">{site.guarantee.terms}</p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section>
    <div class="container-z py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="h-section">Three things, <em class="text-accent">done well.</em></h2>
        <a href="/services" class="btn-ghost">Full scope & what's included →</a>
      </div>
      <div class="mt-10 border-t border-hairline md:mt-14">
        {services.map((s, i) => (
          <a href={`/services#${s.slug}`} class="svc-row group grid gap-3 border-b border-hairline py-7 md:grid-cols-12 md:items-center md:gap-8 md:py-8" data-reveal style={`--d:${i * 60}ms`}>
            <p class="font-mono text-xs text-accent md:col-span-1">{s.index}</p>
            <h3 class="svc-title md:col-span-7">{s.title}</h3>
            <p class="body text-[0.9375rem] md:col-span-3">{s.summary.split(". ")[0].replace(/\.$/, "")}.</p>
            <span class="svc-arrow hidden justify-self-end md:col-span-1 md:flex" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="work" class="scroll-mt-16 border-t border-hairline">
    <div class="container-z py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="eyebrow">Work</p>
          <h2 class="h-section mt-4">Real projects, <em class="text-accent">shown with permission.</em></h2>
        </div>
        <a href="/work" class="btn-ghost">All work →</a>
      </div>
      <div class="mt-10 md:mt-12"><WorkShowcase /></div>
    </div>
  </section>

  <!-- PROCESS + PRICING (deep band) -->
  <section class="band-deep">
    <div class="container-z py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow">How it works</p>
          <h2 class="h-section mt-5">Plain steps, <em class="text-accent-on-deep">one price.</em></h2>
          <p class="body mt-5 max-w-[40ch]">{pricing.body}</p>
          <a href="/book" class="btn-primary mt-8">Book a 20-min call <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="grid grid-cols-2 gap-x-6 gap-y-8 self-start lg:col-span-8 xl:grid-cols-4">
          {site.steps.map((s, i) => (
            <li class="border-t border-deep-ink pt-5" data-reveal style={`--d:${i * 80}ms`}>
              <p class="step-num">{s.index}</p>
              <h3 class="mt-4 text-[1.25rem] font-semibold tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-deep-ink-2">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-deep-line pt-6 font-mono text-xs uppercase tracking-[0.12em] text-deep-ink-2" data-reveal>
        {site.pricing.points.map((pt) => <li class="flex items-center gap-2.5"><span class="h-px w-3 bg-accent-on-deep" aria-hidden="true"></span>{pt}</li>)}
      </ul>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="scroll-mt-16 border-t border-hairline">
    <div class="container-z grid gap-14 py-16 md:py-24 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">About</p>
        <h2 class="h-section mt-5"><em>{site.about.title}</em></h2>
        <p class="lead mt-6 !text-ink">{site.about.paragraphs[0]}</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-10" data-reveal style="--d:120ms">
        <p class="body">{site.about.paragraphs[1]}</p>
        <p class="body mt-4">{site.about.paragraphs[2]}</p>
        <a href="/book" class="btn-ghost mt-4">Talk it through on a 20-min call →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-hairline">
    <div class="container-z grid gap-8 py-16 md:grid-cols-12 md:gap-8 md:py-24">
      <h2 class="h-section md:col-span-4" data-reveal>Straight <em class="text-accent">answers.</em></h2>
      <div class="md:col-span-8"><Faq /></div>
    </div>
  </section>

  <ClosingBand />
</Base>
