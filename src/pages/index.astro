---
import Base from '../layouts/Base.astro';
import LeadFlow from '../components/LeadFlow.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import Detector from '../components/Detector.astro';
import HeroPhone from '../components/HeroPhone.astro';
import ScrollReveal from '../components/react-bits/ScrollReveal';
import SpotlightCard from '../components/react-bits/SpotlightCard';
import Magnet from '../components/react-bits/Magnet';
import Faq from '../components/Faq.astro';
import ClosingBand from '../components/ClosingBand.astro';
import site from '../content/site.json';
import services from '../content/services.json';

const pricing = site.pricing.mode === 'guide' ? site.pricing.guide : site.pricing.fixedQuote;
---
<Base
  title="Zelux: Websites & Business Systems | UK Studio"
  description="Bespoke websites, workflow automation and connected business systems for UK businesses. Direct with Kaden Ekuma Bokome. Book a 20-minute intro call."
>
  <!-- HERO -->
  <section class="hero-grid relative">
    <div class="container-z pb-10 pt-10 md:pb-14 md:pt-16">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 rounded-full border border-hairline bg-paper px-3 py-1.5 text-[0.8125rem] font-medium text-ink-2" data-reveal>
            <span class="relative flex h-2 w-2" aria-hidden="true"><span class="live-ping absolute inset-0 rounded-full bg-live"></span><span class="relative h-2 w-2 rounded-full bg-live"></span></span>{site.hero.status}
          </p>
          <h1 class="h-hero mt-6" data-reveal style="--d:50ms">
            {site.hero.titleLead} <em class="text-accent">{site.hero.titleItalic}</em>
          </h1>
          <p class="lead mt-6 max-w-[52ch]" data-reveal style="--d:100ms">{site.hero.subtitle}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-2" data-reveal style="--d:150ms">
            <Magnet client:idle padding={70} magnetStrength={5} maxOffset={10} spring={{ stiffness: 170, damping: 26 }}><a href="/book" class="btn-primary btn-lg">Book a free 20-min call <span class="arrow" aria-hidden="true">→</span></a></Magnet>
            <a href="#time-saver" class="btn-ghost">Find what to automate ↓</a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-hairline pt-5 text-[0.9375rem] font-medium text-ink" data-reveal style="--d:200ms">
            {site.speed.map((t) => (
              <li class="flex items-center gap-2.5"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="text-accent"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{t}</li>
            ))}
          </ul>
        </div>
        <div class="flex justify-center lg:col-span-5 lg:justify-end" data-reveal style="--d:200ms">
          <HeroPhone />
        </div>
      </div>
    </div>
  </section>

  <!-- STATEMENT (accent band) -->
  <section class="band-deep">
    <div class="container-z grid gap-10 py-16 md:py-28 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" data-reveal>
        <ScrollReveal client:visible containerClassName="h-statement" baseOpacity={0.42} enableBlur={false} baseRotation={0} stagger={0.08} wordAnimationEnd="center 40%" text="You speak to the person who builds it." />
        <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-deep-ink-2">{site.pillars[0].body}</p>
        <a href={`mailto:${site.email}`} class="group mt-10 inline-flex items-center gap-3 rounded-full border border-deep-line py-1.5 pl-1.5 pr-4 text-sm text-deep-ink transition-colors hover:border-accent-on-deep">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-accent-on-deep font-serif text-base text-deep" aria-hidden="true">K</span>
          <span>Straight to my inbox: <span class="text-accent-on-deep">{site.email}</span></span>
        </a>
      </div>
      <div class="self-end lg:col-span-5" data-reveal style="--d:90ms">
        <h3 class="text-[1.375rem] font-medium tracking-[-0.02em]">{site.promises.title}</h3>
        <ul class="mt-4 divide-y divide-deep-line border-y border-deep-line">
          {site.promises.items.map((t) => (
            <li class="flex gap-3 py-3 text-[0.9375rem] leading-relaxed text-deep-ink-2">
              <svg class="mt-1 shrink-0 text-accent-on-deep" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER DEMO -->
  <section class="border-b border-hairline">
    <div class="container-z py-16 md:py-24">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end" data-reveal>
        <h2 class="h-section lg:col-span-7">Same enquiry.<br class="hidden sm:block" /> Two very different days.</h2>
        <p class="body lg:col-span-5">Flip between doing it by hand and a connected system, and watch where the job goes.</p>
      </div>
      <div class="mt-10 md:mt-12" data-reveal><LeadFlow /></div>
    </div>
  </section>

  <!-- TIME-SAVER DETECTOR -->
  <section id="time-saver" class="scroll-mt-16 border-b border-hairline bg-surface">
    <div class="container-z py-14 md:py-20">
      <div class="max-w-[46rem]" data-reveal>
        <p class="eyebrow">Try it</p>
        <h2 class="h-section mt-4">What should stop taking your time?</h2>
        <p class="body mt-4">Nine of the jobs small businesses still do by hand. Pick one to see how it would run, where you stay in control, and what it plugs into. <a href="/services#automations" class="text-ink underline decoration-hairline-strong underline-offset-4 hover:text-accent">See all ten automations</a>.</p>
      </div>
      <div class="mt-10 md:mt-12" data-reveal style="--d:90ms"><Detector /></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section>
    <div class="container-z py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="h-section">Three things, done well.</h2>
        <a href="/services" class="btn-ghost">Full scope & what's included →</a>
      </div>
      <div class="mt-10 border-t border-hairline md:mt-14">
        {services.map((s, i) => (
          <a href={`/services#${s.slug}`} class="svc-row group grid gap-3 border-b border-hairline py-7 md:grid-cols-12 md:items-center md:gap-8 md:py-8" data-reveal style={`--d:${i * 60}ms`}>
            <div class="svc-move md:col-span-5">
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent">{s.index} · {s.tag}</p>
              <h3 class="svc-title mt-2">{s.title}</h3>
            </div>
            <div class="svc-move md:col-span-6">
              <p class="body text-[0.9375rem]">{s.summary.split(". ")[0].replace(/\.$/, "")}.</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.chips.map((t) => <li class="rounded-full border border-hairline bg-paper px-2.5 py-1 text-xs text-ink-2">{t}</li>)}
              </ul>
            </div>
            <span class="svc-arrow hidden justify-self-end md:col-span-1 md:flex" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section id="portfolio" class="scroll-mt-16 border-t border-hairline">
    <div class="container-z py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <h2 class="h-section">Two live builds. More on the bench.</h2>
          <p class="body mt-3 max-w-[52ch]">Forge and KrapMaps are live and shown with permission. The rest are labelled: one client build in progress and two concepts.</p>
        </div>
        <a href="/portfolio" class="btn-ghost">Full portfolio →</a>
      </div>
      <div class="mt-10 md:mt-12" data-reveal><ProjectCarousel /></div>
    </div>
  </section>

  <!-- PROCESS + PRICING (deep band) -->
  <section class="band-deep">
    <div class="container-z py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow">How it works</p>
          <h2 class="h-section mt-5">Plain steps, one price.</h2>
          <p class="body mt-5 max-w-[40ch]">{pricing.body}</p>
          <a href="/book" class="btn-primary mt-8">Book a free 20-min call <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="grid grid-cols-2 gap-x-6 gap-y-8 self-start lg:col-span-8 xl:grid-cols-4">
          {site.steps.map((s, i) => (
            <li class="relative border-t border-deep-line pt-5" data-reveal style={`--d:${i * 50}ms`}>
              <span class="step-line absolute -top-px left-0 h-px w-full origin-left bg-accent-on-deep" aria-hidden="true"></span>
              <p class="step-num">{s.index}</p>
              <h3 class="mt-4 text-[1.25rem] font-semibold tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-deep-ink-2">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="mt-12" data-reveal>
        <SpotlightCard client:visible theme="dark" spotlightColor="#6ea0ff" intensity={0.5} borderGlow={0.9} className="grid items-center gap-5 p-6 md:grid-cols-12 md:p-7" style={{ '--spotlight-card-border': '#263352', '--spotlight-card-surface': '#16213a' }}>
          <div class="flex items-center gap-4 md:col-span-5">
            <span class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-full bg-accent-on-deep text-deep" aria-hidden="true">
              <span class="text-[1.375rem] font-semibold leading-none">7</span><span class="mt-0.5 font-mono text-[0.5625rem] uppercase leading-none tracking-[0.1em]">days</span>
            </span>
            <div>
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent-on-deep">{site.guarantee.title}</p>
              <h3 class="mt-1 text-[1.5rem] font-semibold leading-tight tracking-[-0.025em] text-deep-ink">{site.guarantee.short}</h3>
            </div>
          </div>
          <p class="text-[0.9375rem] leading-relaxed text-deep-ink-2 md:col-span-7">{site.guarantee.terms}</p>
        </SpotlightCard>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="scroll-mt-16 border-t border-hairline">
    <div class="container-z grid items-stretch gap-6 py-16 md:py-24 lg:grid-cols-12 lg:gap-8">
      <!-- Profile card (the monogram tile is where a photo goes) -->
      <aside class="relative isolate overflow-hidden rounded-[calc(var(--radius-card)+0.5rem)] bg-deep p-6 text-deep-ink md:p-8 lg:col-span-5 [&>*:not([aria-hidden])]:relative [&>*:not([aria-hidden])]:z-[1]" data-reveal>
        <div class="flex items-start justify-between gap-4">
          <span class="grid h-24 w-24 place-items-center rounded-[26px] bg-accent-on-deep font-serif text-[3.25rem] leading-none text-deep md:h-28 md:w-28 md:text-[3.75rem]" aria-hidden="true">K</span>
          <span class="inline-flex items-center gap-2 rounded-full border border-deep-line px-3 py-1.5 text-xs font-semibold text-deep-ink">
            <span class="h-2 w-2 rounded-full bg-[#4ade80]" aria-hidden="true"></span>Taking on new builds
          </span>
        </div>
        <h2 class="mt-8 font-serif text-[clamp(1.75rem,3vw,2.25rem)] leading-tight">{site.founder}</h2>
        <p class="mt-1 text-deep-ink-2">Web &amp; systems builder · Hampshire, UK</p>
        <ul class="mt-8 grid gap-3 border-t border-deep-line pt-6 text-[0.9375rem]">
          {[
            'One person, from first call to launch',
            'Plain-English updates, no account managers',
            'Usually replies within one working day',
          ].map((t) => (
            <li class="flex gap-3 text-deep-ink">
              <svg class="mt-1 shrink-0 text-accent-on-deep" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>{t}
            </li>
          ))}
        </ul>
        <span class="pointer-events-none absolute -bottom-24 -right-24 -z-0 hidden h-56 w-56 rounded-full border border-deep-line md:block" aria-hidden="true"></span>
        <span class="pointer-events-none absolute -bottom-36 -right-36 -z-0 hidden h-80 w-80 rounded-full border border-deep-line opacity-60 md:block" aria-hidden="true"></span>
      </aside>

      <div class="flex flex-col justify-between gap-8 lg:col-span-7" data-reveal style="--d:80ms">
        <div>
          <p class="eyebrow">Why Zelux exists</p>
          <p class="mt-4 font-serif text-[clamp(1.75rem,3.2vw,2.625rem)] leading-[1.12] tracking-[-0.03em] text-ink">
            Most small businesses get stuck between <span class="text-ink-3">cheap templates</span> and <span class="text-ink-3">£10,000 agencies.</span> <span class="text-accent">Zelux is the bit in between.</span>
          </p>
          <p class="body mt-5 max-w-[58ch]">{site.about.detail}</p>
        </div>
        <dl class="grid grid-cols-3 gap-3">
          {[
            ['1', 'person you deal with'],
            ['48h', 'to a fixed quote'],
            ['7 days', 'to a live site'],
          ].map(([n, l]) => (
            <div class="rounded-card border border-hairline bg-paper p-4 md:p-5">
              <dt class="whitespace-nowrap font-serif text-[clamp(1.5rem,3.4vw,2.5rem)] leading-none tracking-[-0.03em] text-accent">{n}</dt>
              <dd class="mt-2 text-sm leading-snug text-ink-2">{l}</dd>
            </div>
          ))}
        </dl>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="/book" class="btn-primary">Book a free 20-min call <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/portfolio" class="btn-ghost">See the portfolio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-hairline">
    <div class="container-z grid gap-8 py-16 md:grid-cols-12 md:gap-8 md:py-24">
      <div class="md:col-span-4" data-reveal>
        <h2 class="h-section">Straight answers.</h2>
        <p class="body mt-4 max-w-[34ch]">Something not covered? Ask me at <a href={`mailto:${site.email}`} class="text-ink underline decoration-hairline-strong underline-offset-4 hover:text-accent">{site.email}</a>.</p>
      </div>
      <div class="md:col-span-8"><Faq /></div>
    </div>
  </section>

  <ClosingBand />
</Base>
