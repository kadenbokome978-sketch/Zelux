---
import Base from '../layouts/Base.astro';
import LeadFlow from '../components/LeadFlow.astro';
import Faq from '../components/Faq.astro';
import ClosingBand from '../components/ClosingBand.astro';
import site from '../content/site.json';
import services from '../content/services.json';
import work from '../content/work.json';
import automations from '../content/automations.json';

const pricing = site.pricing.mode === 'guide' ? site.pricing.guide : site.pricing.fixedQuote;
---
<Base
  title="Zelux: Websites & Business Systems | UK Studio"
  description="Bespoke websites, workflow automation and connected business systems for UK businesses. Direct with Kaden Ekuma Bokome. Book a 20-minute intro call."
>
  <!-- HERO -->
  <section class="hero-grid relative">
    <div class="container-z pb-10 pt-10 md:pb-14 md:pt-16">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3" data-reveal>
        <p class="eyebrow">{site.hero.eyebrow}</p>
        <p class="flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-2">
          <span class="h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>{site.hero.status}
        </p>
      </div>
      <h1 class="h-hero mt-8 md:mt-10" data-reveal style="--d:80ms">
        {site.hero.titleLead} <em class="text-brass">{site.hero.titleItalic}</em>
      </h1>
      <div class="mt-8 grid gap-8 md:mt-12 md:grid-cols-12 md:items-end" data-reveal style="--d:160ms">
        <p class="lead max-w-[52ch] md:col-span-7">{site.hero.subtitle}</p>
        <div class="flex flex-wrap items-center gap-x-7 gap-y-2 md:col-span-5 md:justify-end">
          <a href="/book" class="btn-primary btn-lg">Book a 20-min call <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/services" class="btn-ghost">See what we build</a>
        </div>
      </div>
      <div class="mt-12 md:mt-16" data-reveal style="--d:240ms">
        <LeadFlow />
      </div>
    </div>
  </section>

  <!-- STATEMENT (brass band) -->
  <section class="band-brass">
    <div class="container-z grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="h-statement">You speak to the person who builds it.</h2>
        <p class="mt-6 max-w-[46ch] text-[1.0625rem] leading-relaxed text-brass-ink-2">{site.pillars[0].body}</p>
      </div>
      <ul class="grid gap-px self-end overflow-hidden rounded-[2px] border border-brass-line bg-brass-line lg:col-span-5">
        {site.pillars.slice(1).map((p, i) => (
          <li class="bg-brass p-6" data-reveal style={`--d:${(i + 1) * 90}ms`}>
            <h3 class="text-[1.375rem] font-medium leading-tight tracking-[-0.02em]">{p.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-brass-ink-2">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section>
    <div class="container-z py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="h-section">Three things, <em class="text-brass">done well.</em></h2>
        <a href="/services" class="btn-ghost">Full scope & what's included →</a>
      </div>
      <div class="mt-10 border-t border-hairline md:mt-14">
        {services.map((s, i) => (
          <a href={`/services#${s.slug}`} class="svc-row group grid gap-3 border-b border-hairline py-7 md:grid-cols-12 md:items-center md:gap-8 md:py-8" data-reveal style={`--d:${i * 60}ms`}>
            <p class="font-mono text-xs text-brass md:col-span-1">{s.index}</p>
            <h3 class="svc-title md:col-span-7">{s.title}</h3>
            <p class="body text-[0.9375rem] md:col-span-3">{s.summary.split(". ")[0]}.</p>
            <span class="svc-arrow hidden justify-self-end md:col-span-1 md:flex" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTOMATIONS -->
  <section id="automations" class="scroll-mt-16 border-t border-hairline">
    <div class="marquee border-b border-hairline pb-2 pt-6 md:pt-8" data-paused="false">
      <div class="marquee-track" aria-hidden="true">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {automations.map((a, i) => (
              <span class:list={['marquee-item', i % 2 ? 'is-outline' : '']}>{a.title}<span class="marquee-sep">/</span></span>
            ))}
          </div>
        ))}
      </div>
      <div class="container-z flex justify-end">
        <button type="button" class="marquee-toggle mt-3 inline-flex min-h-10 items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3 hover:text-ink" aria-pressed="false">
          <span class="marquee-toggle-label">Pause motion</span>
        </button>
      </div>
    </div>
    <div class="container-z grid gap-10 py-12 md:py-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Automations</p>
        <h2 class="h-section mt-4">Admin that <em class="text-brass">runs itself.</em></h2>
        <p class="body mt-5 max-w-[36ch]">Ten jobs most small businesses still do by hand. Each one is wired into the tools you already use.</p>
        <a href="/services#automations" class="btn-ghost mt-4">How each one works →</a>
      </div>
      <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {automations.map((a, i) => (
          <li class="border-t border-hairline" data-reveal style={`--d:${(i % 2) * 60}ms`}>
            <a href={`/services#auto-${a.index}`} class="group flex min-h-12 items-baseline gap-4 py-3 sm:py-4">
              <span class="font-mono text-[0.6875rem] text-brass">{a.index}</span>
              <span class="text-[1.125rem] leading-snug tracking-[-0.015em] text-ink transition-colors group-hover:text-brass-hover">{a.title}</span>
              <span class="ml-auto text-ink-3 opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROCESS + PRICING (bone band) -->
  <section class="band-bone">
    <div class="container-z py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-4" data-reveal>
          <p class="eyebrow">How it works</p>
          <h2 class="h-section mt-5">Plain steps, <em class="text-brass-deep">one price.</em></h2>
          <p class="body mt-5 max-w-[40ch]">{pricing.body}</p>
          <a href="/book" class="btn-dark mt-8">Book a 20-min call <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="grid grid-cols-2 gap-x-6 gap-y-8 self-start lg:col-span-8 xl:grid-cols-4">
          {site.steps.map((s, i) => (
            <li class="border-t border-bone-ink pt-5" data-reveal style={`--d:${i * 80}ms`}>
              <p class="step-num">{s.index}</p>
              <h3 class="mt-4 text-[1.25rem] font-semibold tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-2 max-w-[38ch] text-[0.875rem] leading-relaxed text-bone-ink-2">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-bone-line pt-6 font-mono text-xs uppercase tracking-[0.12em] text-bone-ink-2" data-reveal>
        {site.pricing.points.map((pt) => <li class="flex items-center gap-2.5"><span class="h-px w-3 bg-brass-deep" aria-hidden="true"></span>{pt}</li>)}
      </ul>
    </div>
  </section>

  <!-- WORK + ABOUT -->
  <section id="about" class="scroll-mt-16">
    <div class="container-z grid gap-14 py-16 md:py-24 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">About</p>
        <h2 class="h-section mt-5"><em>{site.about.title}</em></h2>
        <p class="lead mt-6 !text-ink">{site.about.paragraphs[0]}</p>
        <p class="body mt-4">{site.about.paragraphs[2]}</p>
      </div>
      <div id="work" class="scroll-mt-16 lg:col-span-6 lg:col-start-7" data-reveal style="--d:120ms">
        <div class="flex items-end justify-between">
          <p class="eyebrow">Selected work</p>
          <a href="/work" class="btn-ghost !min-h-10 text-sm">All work →</a>
        </div>
        <ul class="mt-4 border-t border-hairline">
          {work.map((w) => {
            const Tag = w.href ? 'a' : 'div';
            return (
              <li class="border-b border-hairline">
                <Tag {...(w.href ? { href: w.href, target: '_blank', rel: 'noopener' } : {})} class="group flex items-center justify-between gap-4 py-5">
                  <span>
                    <span class="block font-serif text-[1.375rem] leading-tight text-ink group-hover:text-brass-hover">{w.title}</span>
                    <span class="mt-1 block text-sm text-ink-3">{w.sector}</span>
                  </span>
                  <span class:list={['shrink-0 rounded-[2px] border px-2 py-1 font-mono text-[0.625rem] uppercase tracking-[0.12em]', w.isPlaceholder ? 'border-hairline text-ink-3' : 'border-hairline-accent text-brass']}>
                    {w.isPlaceholder ? (w.status.startsWith('In build') ? 'In build' : 'Slot reserved') : 'Live ↗'}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
        <p class="mt-4 text-sm text-ink-3">Client work is published once it's live and approved. Previews available on request.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-hairline">
    <div class="container-z grid gap-8 py-16 md:grid-cols-12 md:gap-8 md:py-24">
      <h2 class="h-section md:col-span-4" data-reveal>Straight <em class="text-brass">answers.</em></h2>
      <div class="md:col-span-8"><Faq /></div>
    </div>
  </section>

  <ClosingBand />
</Base>
