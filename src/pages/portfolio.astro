---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ClosingBand from '../components/ClosingBand.astro';
import ConceptPhone from '../components/ConceptPhone.astro';
import SiteShowcase from '../components/SiteShowcase.astro';
import work from '../content/work.json';
import '@fontsource/lilita-one/latin-400.css';

type Item = (typeof work)[number] & { image?: string; imageMobile?: string; desktopLong?: string; mobileLong?: string; frame?: string; bar?: string; barInk?: string };
const live = (work as Item[]).filter((w) => !w.isPlaceholder);
const building = (work as Item[]).filter((w) => w.isPlaceholder);
// Brand tints for each live project (text pairs checked for contrast)
const tint: Record<string, { bg: string; ink: string; muted: string; line: string }> = {
  Forge: { bg: '#1c1b19', ink: '#f4efe7', muted: '#c9c1b6', line: '#3a3732' },
  KrapMaps: { bg: '#c42862', ink: '#ffffff', muted: '#fde4ee', line: '#d9528a' },
};
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
---
<Base
  title="Portfolio: Websites & Systems | Zelux"
  description="Websites and systems built by Zelux, shown with permission: Forge, a mobile welder in Havant, and KrapMaps. No invented logos or stats."
>
  <section class="container-z pb-10 pt-14 md:pb-14 md:pt-20">
    <SectionHead as="h1" eyebrow="Portfolio" title="Real projects." italic="Real permission." intro="Every client project here is live and shown with the owner's say-so. Builds in progress and concepts are labelled as such." />
  </section>

  <div class="container-z grid gap-6 pb-14 md:pb-20">
    {live.map((w, i) => {
      const t = tint[w.title] ?? tint.Forge;
      return (
        <article class="overflow-hidden rounded-[calc(var(--radius-card)+0.5rem)]" style={`background:${t.bg};color:${t.ink}`} data-reveal>
          <div class="grid items-center gap-8 lg:grid-cols-12">
            <div class:list={['p-6 md:p-10 lg:col-span-5', i % 2 === 1 && 'lg:order-2']}>
              <span class="inline-flex rounded-full border px-3 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em]" style={`border-color:${t.line}`}>{w.status.includes('Co-founded') ? 'Live · Co-founded' : 'Live · Client'}</span>
              <h2 class:list={['mt-5 font-serif text-[clamp(2.25rem,4vw,3.25rem)] leading-none tracking-[-0.03em]', w.title === 'KrapMaps' && 'font-krap']}>{w.title}</h2>
              <p class="mt-2 text-[0.9375rem]" style={`color:${t.muted}`}>{w.sector}</p>
              <dl class="mt-8 grid gap-5">
                {[['The problem', w.friction], ['What I built', w.built], ['Where it is now', w.outcome]].map(([k, v]) => (
                  <div class="border-t pt-4" style={`border-color:${t.line}`}>
                    <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.12em]" style={`color:${t.muted}`}>{k}</dt>
                    <dd class="mt-1.5 text-[1rem] leading-relaxed">{v}</dd>
                  </div>
                ))}
              </dl>
              {w.href && (
                <a href={w.href} target="_blank" rel="noopener" class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-[0.9375rem] font-semibold" style={`background:${t.ink};color:${t.bg}`}>Visit {host(w.href)} <span aria-hidden="true">↗</span></a>
              )}
            </div>
            {w.desktopLong && (
              <div class:list={['px-6 pb-6 pt-2 md:px-10 md:pb-10 lg:col-span-7 lg:py-10', i % 2 === 1 && 'lg:order-1']}>
                <SiteShowcase title={w.title} host={w.href ? host(w.href) : ''} desktop={w.desktopLong} mobile={w.mobileLong} frame={w.frame!} bar={w.bar!} barInk={w.barInk!} eager={i === 0} hinted />
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <section class="border-t border-hairline bg-surface">
    <div class="container-z grid gap-10 py-14 md:py-20 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-4" data-reveal>
        <h2 class="h-section">On the bench right now.</h2>
        {building.map((w) => (
          <div class="mt-6 rounded-card border border-hairline bg-paper p-6">
            <span class="inline-flex rounded-full bg-accent-tint px-3 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent-hover">In build</span>
            <h3 class="mt-4 text-[1.375rem] font-semibold tracking-[-0.02em] text-ink">{w.title}</h3>
            <p class="mt-1 text-sm text-ink-3">{w.sector} · {w.status.replace(/^In build · /, '')}</p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{w.built}</p>
          </div>
        ))}
        <a href={`/book?need=${encodeURIComponent("I'd like a preview of a build in progress.")}#enquiry`} class="btn-ghost mt-4">Ask for a live preview <span class="ml-1.5" aria-hidden="true">→</span></a>
      </div>
      <div class="min-w-0 lg:col-span-8" data-reveal style="--d:60ms">
        <h2 class="font-serif text-[1.625rem] text-ink">Concept builds</h2>
        <p class="body mt-2 max-w-[52ch]">Made-up businesses, real design: the kind of site I build, each one around a single job.</p>
        <div class="concepts mt-8 grid grid-cols-2 justify-items-center gap-x-3 gap-y-6 sm:grid-cols-3 sm:gap-6">
          <ConceptPhone variant="plumber" size="sm" />
          <ConceptPhone variant="groomer" size="sm" />
          <ConceptPhone variant="bakery" size="sm" />
        </div>
      </div>
    </div>
  </section>

  <ClosingBand />
  <style>
    /* Phones: two small phones a row, the third centred below. No sideways scrolling. */
    @media (max-width: 639px) { .concepts > :global(*) { zoom: 0.72; } .concepts > :global(*:last-child) { grid-column: 1 / -1; } }
  </style>
</Base>
