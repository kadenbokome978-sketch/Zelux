---
import defaultFaqs from '../content/faqs.json';
interface Props { items?: { q: string; a: string }[] }
const faqs = Astro.props.items ?? defaultFaqs;
---
<div class="border-t border-hairline" data-reveal>
  {faqs.map((f, i) => (
    <div class="faq-item border-b border-hairline" data-open="false">
      <h3>
        <button
          type="button"
          class="flex w-full min-h-[52px] items-center justify-between gap-4 py-3 text-left text-[0.9375rem] md:min-h-[64px] md:gap-6 md:py-5 md:text-[1.0625rem] text-ink transition-colors hover:text-accent-hover"
          aria-expanded="false"
          aria-controls={`faq-${i}`}
          id={`faq-btn-${i}`}
        >
          <span>{f.q}</span>
          <span class="faq-icon grid h-8 w-8 shrink-0 place-items-center rounded-full border border-hairline text-accent transition-transform duration-300" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></span>
        </button>
      </h3>
      <div class="faq-panel" id={`faq-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
        <div>
          <p class="body max-w-[62ch] pb-6">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
