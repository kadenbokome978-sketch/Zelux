---
import faqs from '../content/faqs.json';
---
<div class="border-t border-hairline" data-reveal>
  {faqs.map((f, i) => (
    <div class="faq-item border-b border-hairline" data-open="false">
      <h3>
        <button
          type="button"
          class="flex w-full min-h-[64px] items-center justify-between gap-6 py-5 text-left text-[1.0625rem] text-ink transition-colors hover:text-brass-hover"
          aria-expanded="false"
          aria-controls={`faq-${i}`}
          id={`faq-btn-${i}`}
        >
          <span>{f.q}</span>
          <span class="faq-icon text-xl leading-none text-ink-3 transition-transform duration-300" aria-hidden="true">+</span>
        </button>
      </h3>
      <div class="faq-panel" id={`faq-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
        <div>
          <p class="body max-w-[62ch] pb-6">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
