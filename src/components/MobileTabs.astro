---
// Phones only: the homepage splits into five tabs with an app-style bar at the bottom,
// so you see one short part at a time instead of one very long page.
// Sections opt in with data-tab="…". The closing band and footer show under every tab.
// No JS, or wider than 767px: nothing changes, it's one page as before.
const tabs = [
  { id: 'overview', label: 'Overview', icon: 'M3 11 12 4l9 7M5 10v10h14V10' },
  { id: 'automate', label: 'Automate', icon: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z' },
  { id: 'services', label: 'Services', icon: 'M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z' },
  { id: 'work', label: 'Work', icon: 'M3 5h18v14H3V5Zm0 4h18' },
  { id: 'about', label: 'About', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0' },
];
---
<div class="mt-next" hidden>
  <div class="container-z">
    <button type="button" class="mt-next-btn"><span class="mt-next-k">Next</span><span class="mt-next-t"></span><span aria-hidden="true">→</span></button>
  </div>
</div>

<nav class="mt-bar" aria-label="Homepage sections" hidden>
  {tabs.map((t) => (
    <button type="button" class="mt-tab" data-go={t.id} aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>
      <span>{t.label}</span>
    </button>
  ))}
</nav>

<style>
  .mt-bar {
    position: fixed; z-index: 40; left: 0.5rem; right: 0.5rem; bottom: calc(0.5rem + env(safe-area-inset-bottom));
    display: grid; grid-template-columns: repeat(5, 1fr); padding: 0.3rem;
    border-radius: 1.25rem; background: rgb(15 23 42 / 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px -16px rgb(15 23 42 / 0.55);
  }
  .mt-bar[hidden], .mt-next[hidden] { display: none; }
  .mt-tab { position: relative; display: grid; justify-items: center; gap: 0.2rem; min-height: 52px; padding: 0.45rem 0 0.4rem; border-radius: 1rem; color: var(--color-deep-ink-2); font-size: 0.6875rem; font-weight: 600; transition: color var(--dur-fast), background-color var(--dur-ui); }
  .mt-tab svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .mt-tab[aria-pressed='true'] { color: var(--color-deep); background: var(--color-accent-on-deep); }
  .mt-tab:active { transform: scale(0.96); }

  .mt-next { padding: 0.5rem 0 2rem; }
  .mt-next-btn { display: flex; align-items: center; gap: 0.75rem; width: 100%; min-height: 64px; padding: 0 1.25rem; border-radius: var(--radius-card); background: var(--color-paper); border: 1px solid var(--color-hairline); color: var(--color-ink); font-weight: 600; text-align: left; }
  .mt-next-k { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 400; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-hover); }
  .mt-next-t { flex: 1; font-size: 1.0625rem; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.m-tabs [data-tab-on]) { animation: mt-in 260ms var(--ease-out-soft); }
  }
  @keyframes mt-in { from { opacity: 0; transform: translateY(6px); } }
</style>

<style is:global>
  /* Tab mode: only the chosen tab's sections show; room at the bottom for the bar */
  html.m-tabs [data-tab]:not([data-tab-on]) { display: none !important; }
  html.m-tabs body { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.mt-bar');
  const next = document.querySelector<HTMLElement>('.mt-next');
  if (bar && next) {
    const mq = matchMedia('(max-width: 767px)');
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('.mt-tab'));
    const ids = buttons.map((b) => b.dataset.go!);
    const label = (id: string) => buttons.find((b) => b.dataset.go === id)?.textContent?.trim() ?? '';
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));
    let current = 'overview';

    const show = (id: string, scroll: 'top' | Element | null = 'top') => {
      current = id;
      sections.forEach((s) => s.toggleAttribute('data-tab-on', s.dataset.tab === id));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.go === id)));
      const i = ids.indexOf(id);
      const n = ids[(i + 1) % ids.length];
      next.querySelector('.mt-next-t')!.textContent = i === ids.length - 1 ? `Back to ${label(n)}` : label(n);
      next.querySelector('.mt-next-k')!.textContent = i === ids.length - 1 ? 'Start again' : 'Next';
      (next.querySelector('button') as HTMLButtonElement).dataset.go = n;
      window.dispatchEvent(new Event('resize')); // let carousels re-measure now they're visible
      if (scroll === 'top') window.scrollTo({ top: 0, behavior: 'auto' });
      else if (scroll) requestAnimationFrame(() => scroll.scrollIntoView({ block: 'start' }));
      try { history.replaceState(null, '', id === 'overview' ? location.pathname : `#${id}`); } catch { /* ignore */ }
    };

    // Which tab holds a given #anchor (or a tab name itself)
    const tabFor = (hash: string) => {
      const name = hash.replace(/^#/, '');
      if (ids.includes(name)) return { tab: name, el: null };
      const el = name ? document.getElementById(name) : null;
      const owner = el?.closest<HTMLElement>('[data-tab]');
      return owner ? { tab: owner.dataset.tab!, el } : null;
    };

    const enable = () => {
      document.documentElement.classList.add('m-tabs');
      bar.hidden = false; next.hidden = false;
      const t = tabFor(location.hash);
      show(t?.tab ?? 'overview', t?.el ?? null);
    };
    const disable = () => {
      document.documentElement.classList.remove('m-tabs');
      bar.hidden = true; next.hidden = true;
      sections.forEach((s) => s.removeAttribute('data-tab-on'));
    };

    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.go!)));
    next.querySelector('button')!.addEventListener('click', (e) => show((e.currentTarget as HTMLElement).dataset.go!));

    // In-page links (#time-saver, /#about…) jump to the right tab first
    document.addEventListener('click', (e) => {
      if (!mq.matches) return;
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!a || a.pathname !== location.pathname) return;
      const t = tabFor(a.hash);
      if (!t) return;
      e.preventDefault();
      show(t.tab, t.el ?? 'top');
    });

    addEventListener('hashchange', () => {
      if (!mq.matches) return;
      const t = tabFor(location.hash);
      if (t && t.tab !== current) show(t.tab, t.el ?? 'top');
    });
    const apply = () => (mq.matches ? enable() : disable());
    mq.addEventListener('change', apply);
    apply();
  }
</script>
