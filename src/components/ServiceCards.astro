---
// Homepage services: three cards, each with a small working illustration of what you get.
// Illustrations are static by default and only move on hover/focus with a real pointer
// (no motion on touch, none with reduced motion), so nothing competes with the demos above.
import services from '../content/services.json';
---
<div class="sc-grid">
  {services.map((s, i) => (
    <a href={`/services#${s.slug}`} class="sc group" data-reveal style={`--d:${i * 70}ms`}>
      <div class:list={['sc-vis', `sc-vis-${s.slug}`]} aria-hidden="true">
        {s.slug === 'websites' && (
          <div class="v-site">
            <div class="v-bar"><i></i><i></i><i></i><span>yourbusiness.co.uk</span></div>
            <div class="v-body">
              <span class="v-h"></span><span class="v-h v-h2"></span>
              <span class="v-p"></span>
              <span class="v-book">Book now</span>
              <span class="v-slots"><i></i><i class="on"></i><i></i><i></i></span>
            </div>
            <span class="v-cursor"><svg viewBox="0 0 16 20"><path d="M1 1l13 9-6 1.5L5 19z" /></svg></span>
            <span class="v-toast"><b>✓</b>New booking · Tue 9:00</span>
          </div>
        )}
        {s.slug === 'automation' && (
          <div class="v-flow">
            {['Form', 'Inbox', 'Sheet', 'Diary'].map((t, n) => (
              <span class="v-node" style={`--n:${n}`}><b>{t}</b></span>
            ))}
            <span class="v-line"><i></i></span>
            <span class="v-dot"></span>
          </div>
        )}
        {s.slug === 'care' && (
          <div class="v-status">
            <p class="v-ok"><span></span>All systems normal</p>
            <div class="v-bars">{Array.from({ length: 30 }, (_, n) => <i style={`--n:${n}`}></i>)}</div>
            <p class="v-row"><span>Enquiry form</span><b>Checked</b></p>
            <p class="v-row"><span>Updates</span><b>Up to date</b></p>
          </div>
        )}
      </div>
      <p class="sc-k">{s.index} · {s.tag}</p>
      <h3 class="sc-t">{s.title}</h3>
      <p class="sc-p">{s.summary.split('. ')[0].replace(/\.$/, '')}.</p>
      <ul class="sc-chips">{s.chips.map((t) => <li>{t}</li>)}</ul>
      <span class="sc-more">What's included <span aria-hidden="true">→</span></span>
    </a>
  ))}
</div>

<style>
  .sc-grid { display: grid; gap: 1rem; }
  /* Phones: stacked, with a shorter picture */
  @media (max-width: 899px) { .sc-vis { height: 8rem; margin-bottom: 1rem; } .sc { padding-bottom: 1.1rem; } }
  @media (min-width: 900px) { .sc-grid { grid-template-columns: repeat(3, 1fr); } }
  .sc { display: flex; flex-direction: column; padding: 0.75rem 0.75rem 1.4rem; border-radius: calc(var(--radius-card) + 0.25rem); background: var(--color-paper); border: 1px solid var(--color-hairline); color: var(--color-ink); transition: border-color var(--dur-ui), transform var(--dur-ui) var(--ease-out-soft), box-shadow var(--dur-ui); }
  .sc > :not(.sc-vis) { margin-inline: 0.75rem; }
  .sc:focus-visible { outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .sc:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: 0 24px 40px -28px rgb(15 23 42 / 0.35); }
  }
  .sc-vis { position: relative; height: 11.5rem; margin-bottom: 1.25rem; overflow: hidden; border-radius: var(--radius-card); background: var(--color-surface); }
  .sc-k { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-hover); }
  .sc-t { margin-top: 0.5rem; font-family: var(--font-serif); font-weight: 500; font-size: 1.5rem; line-height: 1.1; letter-spacing: -0.03em; transition: color var(--dur-ui); }
  .sc:hover .sc-t, .sc:focus-visible .sc-t { color: var(--color-accent); }
  .sc-p { margin-top: 0.6rem; font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2); }
  .sc-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; padding: 0; list-style: none; }
  .sc-chips li { padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--color-hairline); font-size: 0.75rem; color: var(--color-ink-2); }
  .sc-more { margin-top: auto; padding-top: 1.1rem; font-size: 0.875rem; font-weight: 600; color: var(--color-accent-hover); }
  .sc-more span { display: inline-block; transition: transform var(--dur-ui) var(--ease-out-soft); }
  .sc:hover .sc-more span { transform: translateX(3px); }

  /* --- websites: a mini site taking a booking --- */
  .v-site { position: absolute; left: 1.25rem; right: 1.25rem; top: 1.25rem; bottom: -0.5rem; border-radius: 12px; background: #0e3b2f; box-shadow: 0 18px 30px -18px rgb(15 23 42 / 0.5); overflow: hidden; }
  .v-bar { display: flex; align-items: center; gap: 4px; height: 22px; padding: 0 8px; background: #0b3127; }
  .v-bar i { width: 6px; height: 6px; border-radius: 999px; background: #2a5a4b; }
  .v-bar span { margin-left: 6px; font-family: var(--font-mono); font-size: 9px; color: #9cc7b8; }
  .v-body { position: relative; display: grid; gap: 7px; padding: 12px 14px; }
  .v-h { height: 11px; width: 78%; border-radius: 4px; background: #f3f1e7; }
  .v-h2 { width: 52%; }
  .v-p { height: 6px; width: 64%; border-radius: 3px; background: #2a5a4b; }
  .v-book { justify-self: start; margin-top: 4px; padding: 5px 12px; border-radius: 999px; background: #f2b33d; color: #1d1a10; font-size: 10px; font-weight: 700; transition: transform 160ms; }
  .v-slots { display: flex; gap: 5px; margin-top: 2px; }
  .v-slots i { width: 30px; height: 16px; border-radius: 5px; border: 1px solid #2a5a4b; }
  .v-slots i.on { background: #f2b33d; border-color: #f2b33d; }
  .v-cursor { position: absolute; left: 70%; top: 85%; width: 16px; opacity: 0; }
  .v-cursor svg { display: block; fill: #fff; stroke: #0f172a; stroke-width: 1.2; }
  .v-toast { position: absolute; right: 10px; top: 30px; display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: 10px; background: #fcfdff; color: #0f172a; font-size: 10.5px; font-weight: 600; box-shadow: 0 10px 20px -10px rgb(0 0 0 / 0.5); opacity: 0; transform: translateY(-6px); }
  .v-toast b { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 999px; background: #15803d; color: #fff; font-size: 10px; }

  /* --- automation: one enquiry travelling through your tools --- */
  .v-flow { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, 1fr); align-items: center; padding: 0 1rem; }
  .v-node { position: relative; z-index: 1; display: grid; place-items: center; }
  .v-node b { display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 16px; background: var(--color-paper); border: 1px solid var(--color-hairline); font-size: 0.75rem; font-weight: 600; color: var(--color-ink); box-shadow: 0 10px 20px -14px rgb(15 23 42 / 0.4); transition: background-color 200ms, color 200ms, border-color 200ms; }
  .v-node:last-of-type b { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .v-line { position: absolute; left: 12.5%; right: 12.5%; top: 50%; height: 2px; margin-top: -1px; background: var(--color-hairline-accent); }
  .v-line i { position: absolute; inset: 0; background: var(--color-accent); transform: scaleX(1); transform-origin: left; }
  .v-dot { position: absolute; z-index: 0; left: 12.5%; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 999px; background: var(--color-accent); box-shadow: 0 0 0 5px rgb(37 99 235 / 0.2); opacity: 0; }

  /* --- care: a calm status board --- */
  .v-status { position: absolute; inset: 1.25rem; display: grid; align-content: center; gap: 0.6rem; padding: 0.9rem 1rem; border-radius: 12px; background: var(--color-paper); border: 1px solid var(--color-hairline); }
  .v-ok { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-weight: 600; color: #14532d; }
  .v-ok span { width: 8px; height: 8px; border-radius: 999px; background: #15803d; box-shadow: 0 0 0 4px #dcfce7; }
  .v-bars { display: grid; grid-template-columns: repeat(30, 1fr); gap: 2px; height: 26px; }
  .v-bars i { border-radius: 2px; background: #4ade80; transform-origin: bottom; }
  .v-row { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--color-ink-2); }
  .v-row b { font-weight: 600; color: #15803d; }

  /* Motion only for a real pointer, only on hover/focus, never with reduced motion */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .sc:hover .v-cursor, .sc:focus-visible .v-cursor { animation: v-cursor 1.6s var(--ease-out-soft) both; }
    .sc:hover .v-book, .sc:focus-visible .v-book { animation: v-press 1.6s both; }
    .sc:hover .v-toast, .sc:focus-visible .v-toast { animation: v-toast 1.6s var(--ease-out-soft) both; }
    .sc:hover .v-line i, .sc:focus-visible .v-line i { animation: v-line 1.8s linear both; }
    .sc:hover .v-dot, .sc:focus-visible .v-dot { animation: v-dot 1.8s linear both; }
    .sc:hover .v-node b, .sc:focus-visible .v-node b { animation: v-node 1.8s both; animation-delay: calc(var(--n) * 0.6s - 0.1s); }
    .sc:hover .v-bars i, .sc:focus-visible .v-bars i { animation: v-bar 600ms var(--ease-out-soft) both; animation-delay: calc(var(--n) * 22ms); }
  }
  @keyframes v-cursor { 0% { opacity: 0; left: 70%; top: 85%; } 15% { opacity: 1; } 45%, 60% { opacity: 1; left: 15%; top: 56%; } 100% { opacity: 0; left: 15%; top: 56%; } }
  @keyframes v-press { 0%, 47% { transform: none; } 52% { transform: scale(0.92); } 58%, 100% { transform: none; } }
  @keyframes v-toast { 0%, 55% { opacity: 0; transform: translateY(-6px); } 70%, 100% { opacity: 1; transform: none; } }
  @keyframes v-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes v-dot { 0% { opacity: 1; left: 12.5%; } 95% { opacity: 1; left: 87.5%; } 100% { opacity: 0; left: 87.5%; } }
  @keyframes v-node { 0% { background: var(--color-paper); color: var(--color-ink); border-color: var(--color-hairline); } 15%, 100% { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); } }
  @keyframes v-bar { 0% { transform: scaleY(0.3); background: #bbf7d0; } 100% { transform: none; } }
</style>
