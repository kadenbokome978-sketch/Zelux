---
import site from '../content/site.json';
---
<section class="band-deep">
  <div class="container-z flex flex-col gap-10 py-16 md:py-24 lg:flex-row lg:items-end lg:justify-between" data-reveal>
    <div>
      <h2 class="h-statement max-w-[12ch]">Ready to get it <em class="text-accent-on-deep">built?</em></h2>
      <p class="body mt-4 max-w-[52ch] text-[1.0625rem]">{site.closing.body}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-2 lg:items-end">
      <a href="/book" class="btn-primary btn-lg w-full md:w-auto">Book a 20-min call <span class="arrow" aria-hidden="true">→</span></a>
      <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center justify-center text-sm text-deep-ink-2 underline decoration-deep-line underline-offset-4 hover:text-deep-ink lg:justify-end">or email {site.email}</a>
    </div>
  </div>
</section>
