---
// Before / after: the same enquiry handled by hand, then by a connected system.
// JS steps through the visible flow while it's on screen. Without JS, or with
// reduced motion, the "after" flow is shown complete and the toggle is hidden.
const flows = {
  before: [
    { label: 'Enquiry arrives', meta: 'Website · 09:41' },
    { label: 'Sits in the inbox', meta: 'Seen at 18:30' },
    { label: 'Copied by hand', meta: 'Into a spreadsheet' },
    { label: 'Reply goes out', meta: 'Next morning' },
    { label: 'Lead has gone', meta: 'Booked someone else', bad: true },
  ],
  after: [
    { label: 'Enquiry arrives', meta: 'Website · 09:41' },
    { label: 'Sorted', meta: 'Job type · area · urgency' },
    { label: 'Reply drafted', meta: 'You approve · 09:42' },
    { label: 'Call booked', meta: 'In your calendar' },
    { label: 'Logged', meta: 'CRM updated · 09:43' },
  ],
};
---
<figure id="leadflow" class="leadflow panel overflow-hidden" data-mode="after" aria-label="The same enquiry handled two ways. By hand it waits in the inbox, is copied into a spreadsheet, gets a reply the next morning and the customer books someone else. With a connected system it is sorted, a reply is drafted for you to approve, a call is booked and the CRM is updated within two minutes.">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-4 py-2.5 sm:px-5">
    <div class="lf-toggle inline-flex rounded-full border border-hairline-strong p-0.5" role="group" aria-label="Show workflow">
      <button type="button" data-set="before" aria-pressed="false">Before</button>
      <button type="button" data-set="after" aria-pressed="true">After</button>
    </div>
    <span class="flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">
      <span class="lf-live h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      <span class="lf-status">Same enquiry, connected system</span>
    </span>
  </div>
  {Object.entries(flows).map(([mode, steps]) => (
    <ol class="lf-track flex flex-col p-4 sm:p-5 lg:flex-row lg:items-stretch" data-flow={mode} hidden={mode === 'before'}>
      {steps.map((s, i) => (
        <>
          {i > 0 && <li class="lf-link" aria-hidden="true"><span></span></li>}
          <li class:list={['lf-node', (s as { bad?: boolean }).bad && 'is-bad']}>
            <span class="lf-dot" aria-hidden="true"></span>
            <span class="font-mono text-[0.6875rem] text-ink-3">0{i + 1}</span>
            <span class="lf-label mt-3 block text-[1.0625rem] font-medium tracking-[-0.01em]">{s.label}</span>
            <span class="mt-1.5 block font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-3">{s.meta}</span>
          </li>
        </>
      ))}
    </ol>
  ))}
  <figcaption class="flex items-center justify-between border-t border-hairline px-4 py-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3 sm:px-5">
    <span>Illustrative example</span>
    <span class="lf-foot">About 2 minutes, and booked</span>
  </figcaption>
</figure>

<style>
  .lf-toggle button {
    min-height: 36px; padding: 0 0.9rem; font-size: 0.8125rem; font-weight: 500;
    color: var(--color-ink-2); border-radius: 999px; transition: background-color var(--dur-ui), color var(--dur-ui), transform var(--dur-ui) var(--ease-out-soft);
  }
  .lf-toggle button:active { transform: scale(0.97);
  }
  .lf-toggle button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-canvas); }

  .lf-node {
    position: relative; flex: 1 1 0; padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--color-hairline); border-radius: var(--radius-inner); background: var(--color-paper);
    transition: border-color 400ms var(--ease-out-soft);
  }
  .lf-dot { position: absolute; top: 1.1rem; right: 1.1rem; width: 7px; height: 7px; border-radius: 999px; background: #c5cdd9; transition: background-color 300ms, box-shadow 300ms; }
  .lf-label { color: var(--color-ink-3); transition: color 300ms; }

  .lf-link { position: relative; height: 18px; width: 1px; margin-left: 1.6rem; background: var(--color-hairline); }
  .lf-link span { position: absolute; inset: 0; background: var(--color-accent); transform: scaleY(0); transform-origin: top; transition: transform 500ms var(--ease-out-soft); }
  @media (min-width: 1024px) {
    .lf-link { height: 1px; width: auto; min-width: 1.75rem; flex: 0 0 1.75rem; margin: 0; align-self: center; }
    .lf-link span { transform: scaleX(0); transform-origin: left; }
  }

  .lf-node.on { border-color: var(--color-hairline-accent); }
  .lf-node.on .lf-label { color: var(--color-ink); }
  .lf-node.on .lf-dot { background: var(--color-accent); box-shadow: 0 0 0 4px rgb(37 99 235 / 0.14); }
  .lf-link.on span { transform: none; }
  .lf-node.is-now { border-color: var(--color-accent); }

  /* Before: grey, slow, ends badly */
  [data-flow='before'] .lf-link span { background: var(--color-ink-3); }
  [data-flow='before'] .lf-node.on { border-color: var(--color-hairline-strong); }
  [data-flow='before'] .lf-node.on .lf-dot { background: var(--color-ink-3); box-shadow: none; }
  [data-flow='before'] .lf-node.is-now { border-color: var(--color-ink-2); }
  [data-flow='before'] .lf-node.is-bad.on { border-color: #b3261e; }
  [data-flow='before'] .lf-node.is-bad.on .lf-dot { background: #b3261e; }
  [data-flow='before'] .lf-node.is-bad.on .lf-label { color: #b3261e; }

  .lf-live { background: var(--color-live); }
  .leadflow[data-mode='before'] .lf-live { background: #b3261e; }
  @media (prefers-reduced-motion: no-preference) { .lf-live { animation: lf-blink 1.6s ease-in-out infinite; } }
  @keyframes lf-blink { 50% { opacity: 0.35; } }
</style>

<style is:global>
  /* No JS: hide the toggle and show the finished "after" flow */
  html:not(.js) .lf-toggle { display: none; }
  html:not(.js) .lf-node { border-color: var(--color-hairline-accent); }
  html:not(.js) .lf-node .lf-label { color: var(--color-ink); }
  html:not(.js) .lf-node .lf-dot { background: var(--color-accent); }
  html:not(.js) .lf-link span { transform: none; }
</style>

<script>
  const fig = document.getElementById('leadflow');
  if (fig) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const status = fig.querySelector('.lf-status')!;
    const foot = fig.querySelector('.lf-foot')!;
    const copy = {
      before: ['Same enquiry, handled by hand', 'About 24 hours, and lost'],
      after: ['Same enquiry, connected system', 'About 2 minutes, and booked'],
    } as const;
    type Mode = keyof typeof copy;
    const total = 5;
    let mode: Mode = 'after';
    let step = 0;
    let timer: number | undefined;
    let visible = false;

    const paint = (n: number) => {
      let nodes = 0;
      fig.querySelectorAll<HTMLElement>(`[data-flow="${mode}"] > li`).forEach((el) => {
        if (el.classList.contains('lf-node')) {
          nodes++;
          el.classList.toggle('on', nodes <= n);
          el.classList.toggle('is-now', nodes === n && n < total);
        } else {
          el.classList.toggle('on', nodes < n);
        }
      });
    };
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (reduce) { paint(total); return; }
      step = 0; paint(0);
      if (visible) timer = window.setInterval(() => {
        step = step >= total + 2 ? 0 : step + 1; // hold the finished state for two beats
        paint(Math.min(step, total));
      }, mode === 'before' ? 1400 : 850);
    };
    const setMode = (m: Mode) => {
      mode = m;
      fig.dataset.mode = m;
      fig.querySelectorAll<HTMLElement>('[data-flow]').forEach((ol) => (ol.hidden = ol.dataset.flow !== m));
      fig.querySelectorAll<HTMLButtonElement>('.lf-toggle button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === m)));
      status.textContent = copy[m][0];
      foot.textContent = copy[m][1];
      start();
    };
    fig.querySelectorAll<HTMLButtonElement>('.lf-toggle button').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.set as Mode)),
    );
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { if (!timer) start(); } else stop();
    }, { threshold: 0.35 }).observe(fig);
    setMode('after');
  }
</script>
