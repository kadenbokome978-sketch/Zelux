---
// "What should stop taking your time?" Pick one job, see how it would run.
// All blueprints are rendered on the server (readable without JS, good for search);
// JS just switches which one is showing. Never empty: the first job is selected to start.
import allBlueprints from '../content/blueprints.json';
const blueprints = allBlueprints.filter((b) => (b as { detector?: boolean }).detector !== false);
import automations from '../content/automations.json';
const slugFor = (auto: string) => automations.find((a) => a.index === auto)?.slug;

const toolLabel: Record<string, string> = {
  email: 'Gmail / Outlook', calendar: 'Google / Outlook Calendar', sheets: 'Sheets / Excel', accounts: 'Xero / QuickBooks',
  payments: 'Stripe / SumUp', shop: 'Shopify / WooCommerce', social: 'Facebook / Instagram', sms: 'Text / WhatsApp',
  crm: 'A CRM', website: 'Your website',
};
import { icons } from '../content/icons';
const first = blueprints[0].id;
---
<div id="detector" class="dt grid gap-6 lg:grid-cols-12 lg:gap-8">
  <div class="min-w-0 lg:col-span-5">
    <p class="dt-ask">Pick the job that eats most of your week</p>
    <div class="dt-tiles" role="radiogroup" aria-label="Jobs">
      {blueprints.map((b) => (
        <a
          href={`/automations/${slugFor(b.auto)}`}
          class="dt-tile"
          role="radio"
          aria-checked={b.id === first ? 'true' : 'false'}
          data-id={b.id}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[b.id]} /></svg>
          <span>{b.task}</span>
        </a>
      ))}
    </div>
    <p class="dt-small">Runs in your browser. Nothing you pick is sent anywhere.</p>
  </div>

  <div class="min-w-0 lg:col-span-7">
    <div class="dt-stage" aria-live="polite">
      {blueprints.map((b) => {
        const need = `I'd like to stop spending time on ${b.task.toLowerCase()}.`;
        return (
          <article class="dt-card" data-id={b.id} hidden={b.id !== first}>
            <header class="dt-head">
              <span class="dt-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[b.id]} /></svg></span>
              <div>
                <p class="dt-kicker">How it would run</p>
                <h3 class="dt-title">{b.task}</h3>
              </div>
            </header>
            <div class="dt-body">
              <p class="dt-trigger"><span>Starts when</span>{b.trigger}</p>
              <ol class="dt-steps">
                {b.steps.map((s) => <li>{s}</li>)}
              </ol>
              <p class="dt-control">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.4 3 8.1 7 9.5 4-1.4 7-5.1 7-9.5V6l-7-3Zm-3 9 2 2 4-4" /></svg>
                <span><strong>You stay in control.</strong> {b.approve}</span>
              </p>
              <p class="dt-tools"><span>Works with</span>{b.tools.map((t) => <i>{toolLabel[t]}</i>)}</p>
              <div class="dt-actions">
                <a class="btn-primary" href={`/book?need=${encodeURIComponent(need)}#enquiry`}>Get this built <span class="arrow" aria-hidden="true">→</span></a>
                <a class="btn-ghost" href={`/automations/${slugFor(b.auto)}`}>More detail</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</div>

<style>
  .dt-ask { font-weight: 600; color: var(--color-ink); font-size: 1.0625rem; }
  .dt-tiles { margin-top: 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .dt-tile {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 0.75rem;
    min-height: 6.25rem; padding: 0.85rem; border-radius: var(--radius-inner);
    background: var(--color-paper); border: 1px solid var(--color-hairline); color: var(--color-ink);
    font-size: 0.875rem; font-weight: 600; line-height: 1.25;
    transition: border-color var(--dur-fast), background-color var(--dur-fast), color var(--dur-fast), transform var(--dur-ui) var(--ease-out-soft);
  }
  .dt-tile svg { width: 24px; height: 24px; fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke var(--dur-fast); }
  .dt-tile:active { transform: scale(0.97); }
  .dt-tile[aria-checked='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .dt-tile[aria-checked='true'] svg { stroke: var(--color-on-accent); }
  @media (hover: hover) and (pointer: fine) {
    .dt-tile[aria-checked='false']:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  }
  /* Below desktop: one swipeable row, so the blueprint sits right under what you tapped */
  @media (max-width: 1023px) {
    .dt-tiles { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 9.25rem; overflow-x: auto; scroll-snap-type: x proximity; padding-bottom: 0.25rem; scrollbar-width: none; }
    .dt-tiles::-webkit-scrollbar { display: none; }
    .dt-tile { min-height: 5.5rem; scroll-snap-align: start; }
    .dt-small { margin-top: 0.5rem; }
  }
  .dt-small { margin-top: 1rem; font-size: 0.8125rem; color: var(--color-ink-3); }

  .dt-stage { display: grid; }
  .dt-card { grid-area: 1 / 1; overflow: hidden; border-radius: calc(var(--radius-card) + 0.25rem); background: var(--color-paper); border: 1px solid var(--color-hairline); }
  .dt-card:not([hidden]) { animation: dt-in var(--dur-ui) var(--ease-out-soft); }
  @keyframes dt-in { from { opacity: 0; transform: translateY(8px); } }
  .dt-head { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; background: var(--color-deep); color: var(--color-deep-ink); }
  .dt-icon { display: grid; place-items: center; width: 52px; height: 52px; flex: none; border-radius: 16px; background: var(--color-accent-on-deep); }
  .dt-icon svg { width: 26px; height: 26px; fill: none; stroke: var(--color-deep); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dt-kicker { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-deep-ink-2); }
  .dt-title { margin-top: 0.15rem; font-family: var(--font-serif); font-size: clamp(1.375rem, 2.2vw, 1.75rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 500; }
  .dt-body { padding: 1.5rem; display: grid; gap: 1.1rem; }
  .dt-trigger { font-size: 0.9375rem; color: var(--color-ink); }
  .dt-trigger span { display: block; margin-bottom: 0.2rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-hover); }
  .dt-steps { position: relative; display: grid; gap: 0.6rem; margin: 0; padding: 0 0 0 2.25rem; list-style: none; counter-reset: s; }
  .dt-steps::before { content: ''; position: absolute; left: 0.8rem; top: 0.6rem; bottom: 0.6rem; width: 2px; border-radius: 2px; background: var(--color-hairline-accent); }
  .dt-steps li { position: relative; counter-increment: s; font-size: 0.9375rem; color: var(--color-ink-2); line-height: 1.45; }
  .dt-steps li::before {
    content: counter(s); position: absolute; left: -2.25rem; top: -0.05rem; display: grid; place-items: center; width: 1.65rem; height: 1.65rem;
    border-radius: 999px; background: var(--color-accent-tint); color: var(--color-accent-hover); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;
  }
  .dt-control { display: flex; gap: 0.75rem; padding: 0.85rem 1rem; border-radius: var(--radius-inner); background: #ecfdf3; color: #14532d; font-size: 0.9375rem; line-height: 1.45; }
  .dt-control svg { flex: none; width: 22px; height: 22px; margin-top: 1px; fill: none; stroke: #15803d; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dt-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.8125rem; }
  .dt-tools span { margin-right: 0.25rem; color: var(--color-ink-3); }
  .dt-tools i { font-style: normal; padding: 0.25rem 0.65rem; border-radius: 999px; background: var(--color-surface); color: var(--color-ink-2); }
  .dt-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; padding-top: 0.25rem; }
</style>

<script>
  const root = document.getElementById('detector');
  if (root) {
    const tiles = Array.from(root.querySelectorAll<HTMLAnchorElement>('.dt-tile'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.dt-card'));
    const select = (id: string, focus = false) => {
      tiles.forEach((t) => {
        const on = t.dataset.id === id;
        t.setAttribute('aria-checked', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
        if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      cards.forEach((c) => (c.hidden = c.dataset.id !== id));
    };
    tiles.forEach((t, i) => {
      t.tabIndex = t.getAttribute('aria-checked') === 'true' ? 0 : -1;
      t.addEventListener('click', (e) => { e.preventDefault(); select(t.dataset.id!); });
      // Radio-group keys: arrows move and select, Space/Enter select.
      t.addEventListener('keydown', (e) => {
        const cols = matchMedia('(max-width: 1023px)').matches ? 1 : 3;
        const step = { ArrowRight: 1, ArrowDown: cols, ArrowLeft: -1, ArrowUp: -cols }[e.key];
        if (step) { e.preventDefault(); const n = tiles[(i + step + tiles.length) % tiles.length]; select(n.dataset.id!, true); }
        if (e.key === ' ') { e.preventDefault(); select(t.dataset.id!); }
      });
    });
  }
</script>
