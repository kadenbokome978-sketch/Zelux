---
// "What should stop taking your time?" Pick tasks and tools, get a plain blueprint for each.
// Runs entirely in the browser; nothing is sent anywhere. Without JS it falls back to a list of links.
import blueprints from '../content/blueprints.json';

const tools = [
  { id: 'email', label: 'Gmail / Outlook' },
  { id: 'calendar', label: 'Google / Outlook Calendar' },
  { id: 'sheets', label: 'Sheets / Excel' },
  { id: 'accounts', label: 'Xero / QuickBooks' },
  { id: 'payments', label: 'Stripe / SumUp' },
  { id: 'shop', label: 'Shopify / WooCommerce' },
  { id: 'social', label: 'Facebook / Instagram' },
  { id: 'sms', label: 'Text / WhatsApp' },
  { id: 'crm', label: 'A CRM' },
  { id: 'website', label: 'Your website' },
];
const toolLabel = Object.fromEntries(tools.map((t) => [t.id, t.label]));
---
<div id="detector" class="detector grid gap-8 lg:grid-cols-12 lg:gap-10">
  <div class="lg:col-span-5">
    <fieldset>
      <legend class="text-[1.0625rem] font-semibold text-ink">1. Pick up to three jobs that eat your week</legend>
      <div class="mt-4 flex flex-wrap gap-2" data-group="task">
        {blueprints.map((b) => (
          <button type="button" class="chip" data-id={b.id} aria-pressed="false">{b.task}</button>
        ))}
      </div>
    </fieldset>
    <fieldset class="mt-8">
      <legend class="text-[1.0625rem] font-semibold text-ink">2. What do you already use? <span class="font-normal text-ink-3">(optional)</span></legend>
      <div class="mt-4 flex flex-wrap gap-2" data-group="tool">
        {tools.map((t) => (
          <button type="button" class="chip chip-sm" data-id={t.id} aria-pressed="false">{t.label}</button>
        ))}
      </div>
    </fieldset>
    <p class="mt-6 text-sm text-ink-3">Runs in your browser. Nothing you pick is sent anywhere.</p>
  </div>

  <div class="lg:col-span-7">
    <div class="det-out panel min-h-[22rem] bg-paper" aria-live="polite">
      <div class="det-empty flex h-full min-h-[22rem] flex-col items-center justify-center gap-3 p-8 text-center">
        <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">Your blueprint</span>
        <p class="max-w-[34ch] text-ink-2">Pick a job on the left and you'll see how it would run, where you stay in control, and what it connects to.</p>
      </div>
      <div class="det-results hidden divide-y divide-hairline"></div>
      <div class="det-cta hidden flex-wrap items-center justify-between gap-4 border-t border-hairline bg-surface p-5 sm:p-6">
        <p class="text-[0.9375rem] text-ink"><strong class="font-semibold">Want this built?</strong> I'll walk through it with you on a free 20-minute call.</p>
        <a class="det-book btn-primary" href="/book">Book a free teardown <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <template id="det-card">
    <article class="p-5 sm:p-6">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="det-title text-[1.25rem] font-semibold tracking-[-0.02em] text-ink"></h3>
        <a class="det-more shrink-0 text-sm text-ink-2 underline decoration-hairline-strong underline-offset-4 hover:text-accent" href="#">How it works</a>
      </div>
      <p class="mt-3 text-[0.9375rem] text-ink-2"><span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-accent">Starts when</span><br /><span class="det-trigger"></span></p>
      <ol class="det-steps mt-4 grid gap-2 sm:grid-cols-2"></ol>
      <p class="mt-4 flex gap-3 rounded-inner border border-hairline-accent bg-accent-tint p-3 text-[0.9375rem] text-ink">
        <svg class="mt-0.5 shrink-0 text-accent-hover" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1.5 2.5 4v4.5c0 4 2.8 6.9 6.5 8 3.7-1.1 6.5-4 6.5-8V4L9 1.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m6 9 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <span><strong class="font-semibold">You stay in control:</strong> <span class="det-approve"></span></span>
      </p>
      <p class="det-tools mt-4 text-sm text-ink-3"></p>
    </article>
  </template>
  <script type="application/json" id="det-data" set:html={JSON.stringify({ blueprints, toolLabel })}></script>
</div>

<noscript>
  <ul class="grid gap-2 sm:grid-cols-2">
    {blueprints.map((b) => <li><a class="text-ink underline underline-offset-4" href={`/services#auto-${b.auto}`}>{b.task}</a></li>)}
  </ul>
</noscript>

<style>
  .chip {
    min-height: 40px; padding: 0 0.9rem; border: 1px solid var(--color-hairline-strong); border-radius: 999px;
    background: var(--color-paper); color: var(--color-ink); font-size: 0.9375rem; text-align: left;
    transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast), transform var(--dur-ui) var(--ease-out-soft);
  }
  .chip-sm { min-height: 36px; font-size: 0.875rem; }
  @media (hover: hover) and (pointer: fine) { .chip:hover { border-color: var(--color-accent); } }
  .chip:active:not(:disabled) { transform: scale(0.97); }
  .chip[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .chip[aria-pressed='true']::before { content: '✓ '; }
  .chip:disabled { opacity: 0.45; cursor: not-allowed; }
  html:not(.js) .detector { display: none; }
  :global(.det-step) { display: flex; gap: 0.6rem; font-size: 0.9375rem; color: var(--color-ink-2); }
  :global(.det-step span:first-child) { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-accent); padding-top: 0.2rem; }
</style>

<script>
  const root = document.getElementById('detector');
  const raw = document.getElementById('det-data');
  if (root && raw) {
    type BP = { id: string; task: string; auto: string; trigger: string; steps: string[]; approve: string; tools: string[] };
    const { blueprints, toolLabel } = JSON.parse(raw.textContent || '{}') as { blueprints: BP[]; toolLabel: Record<string, string> };
    const tpl = root.querySelector<HTMLTemplateElement>('#det-card')!;
    const results = root.querySelector<HTMLElement>('.det-results')!;
    const empty = root.querySelector<HTMLElement>('.det-empty')!;
    const cta = root.querySelector<HTMLElement>('.det-cta')!;
    const book = root.querySelector<HTMLAnchorElement>('.det-book')!;
    const MAX = 3;
    const picked = (g: string) =>
      Array.from(root.querySelectorAll<HTMLButtonElement>(`[data-group="${g}"] .chip[aria-pressed="true"]`)).map((b) => b.dataset.id!);

    const render = () => {
      const tasks = picked('task');
      const mine = picked('tool');
      root.querySelectorAll<HTMLButtonElement>('[data-group="task"] .chip').forEach((b) => {
        b.disabled = tasks.length >= MAX && b.getAttribute('aria-pressed') !== 'true';
      });
      results.replaceChildren();
      const chosen = blueprints.filter((b) => tasks.includes(b.id));
      chosen.forEach((b) => {
        const card = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        card.querySelector('.det-title')!.textContent = b.task;
        card.querySelector('.det-trigger')!.textContent = b.trigger;
        card.querySelector('.det-approve')!.textContent = b.approve;
        (card.querySelector('.det-more') as HTMLAnchorElement).href = `/services#auto-${b.auto}`;
        const ol = card.querySelector('.det-steps')!;
        b.steps.forEach((s, i) => {
          const li = document.createElement('li');
          li.className = 'det-step';
          const n = document.createElement('span'); n.textContent = `0${i + 1}`;
          const t = document.createElement('span'); t.textContent = s;
          li.append(n, t); ol.append(li);
        });
        const used = mine.length ? b.tools.filter((t) => mine.includes(t)) : [];
        const toolsEl = card.querySelector('.det-tools')!;
        toolsEl.textContent = used.length
          ? `Works with what you use: ${used.map((t) => toolLabel[t]).join(', ')}.`
          : `Connects to: ${b.tools.map((t) => toolLabel[t]).join(', ')}.`;
        results.append(card);
      });
      const has = chosen.length > 0;
      results.classList.toggle('hidden', !has);
      empty.classList.toggle('hidden', has);
      cta.classList.toggle('hidden', !has);
      cta.classList.toggle('flex', has);
      const need = chosen.map((b) => b.task.toLowerCase()).join(', ');
      const using = mine.map((t) => toolLabel[t]).join(', ');
      const msg = `I'd like to stop spending time on: ${need}.${using ? ` We use: ${using}.` : ''}`;
      book.href = has ? `/book?need=${encodeURIComponent(msg)}#enquiry` : '/book';
    };
    root.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) =>
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        render();
      }),
    );
  }
</script>
