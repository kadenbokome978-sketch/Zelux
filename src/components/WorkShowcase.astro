---
// Homepage portfolio: real screenshots of live work (lead project large, with a phone view),
// then the next project and any honestly labelled reserved slot.
// Screenshots live in public/work/: <slug>-desktop.webp (1600x1000) and <slug>-mobile.webp (600x1298).
import work from '../content/work.json';

type Item = (typeof work)[number] & { image?: string; imageMobile?: string; role?: string };
const items = [...(work as Item[])].sort((a, b) => Number(a.isPlaceholder) - Number(b.isPlaceholder));
const [lead, ...rest] = items;
const badge = (w: Item) => (w.isPlaceholder ? (w.status.startsWith('In build') ? 'In build' : 'Awaiting sign-off') : 'Live');
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
---
<div class="grid gap-5 lg:grid-cols-12">
  <!-- Lead project: desktop screenshot with the phone view overlapping -->
  <article class="panel group flex flex-col overflow-hidden bg-paper lg:col-span-7" data-reveal>
    <div class="relative overflow-hidden border-b border-hairline bg-surface p-4 pb-0 sm:p-6 sm:pb-0">
      <div class="relative">
        <div class="overflow-hidden rounded-t-[6px] border border-b-0 border-hairline-strong/40 bg-paper">
          <div class="flex items-center gap-1.5 border-b border-hairline px-3 py-2" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-hairline"></span><span class="h-2 w-2 rounded-full bg-hairline"></span><span class="h-2 w-2 rounded-full bg-hairline"></span>
            <span class="ml-3 truncate font-mono text-[0.625rem] text-ink-3">{lead.href && host(lead.href)}</span>
          </div>
          <img src={lead.image} alt={`${lead.title} website homepage on a laptop`} class="block aspect-[16/10] w-full object-cover object-top" loading="lazy" decoding="async" width="1600" height="1000" />
        </div>
        {lead.imageMobile && (
          <div class="wk-phone absolute -bottom-px right-3 w-[26%] min-w-[96px] max-w-[150px] sm:right-6">
            <img src={lead.imageMobile} alt={`${lead.title} website on a phone`} class="block w-full rounded-t-[14px] border-[5px] border-b-0 border-[#0b1120]" loading="lazy" decoding="async" width="600" height="1298" />
          </div>
        )}
      </div>
      <span class="absolute right-3 top-3 rounded-[2px] border border-hairline-accent bg-paper px-2 py-1 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-accent">{badge(lead)}</span>
    </div>
    <div class="flex flex-1 flex-col gap-4 p-6 md:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="font-serif text-[1.625rem] leading-tight text-ink">{lead.title}</h3>
        <p class="text-sm text-ink-3">{lead.sector}</p>
      </div>
      <p class="body text-[0.9375rem]">{lead.friction}</p>
      <p class="text-[0.9375rem] leading-relaxed text-ink-2"><span class="text-ink">What I built:</span> {lead.built}</p>
      {lead.href && (
        <a href={lead.href} target="_blank" rel="noopener" class="btn-ghost mt-auto self-start">Visit {host(lead.href)} <span aria-hidden="true">↗</span></a>
      )}
    </div>
  </article>

  <div class="grid gap-5 lg:col-span-5">
    {rest.map((w, i) => (
      <article class="panel flex flex-col overflow-hidden bg-paper" data-reveal style={`--d:${(i + 1) * 50}ms`}>
        <div class:list={['relative overflow-hidden border-b border-hairline', w.image ? 'bg-surface' : 'wk-hatch flex h-32 items-center justify-center']}>
          {w.image ? (
            <img src={w.image} alt={`${w.title} website homepage`} class="block aspect-[16/8] w-full object-cover object-top" loading="lazy" decoding="async" width="1600" height="1000" />
          ) : (
            <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">{w.status.startsWith('In build') ? 'Preview after launch' : 'Shown once approved'}</span>
          )}
          <span class:list={['absolute right-3 top-3 rounded-[2px] border bg-paper px-2 py-1 font-mono text-[0.625rem] uppercase tracking-[0.12em]', w.isPlaceholder ? 'border-hairline text-ink-2' : 'border-hairline-accent text-accent']}>{badge(w)}</span>
        </div>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-[1.25rem] font-medium leading-tight tracking-[-0.02em] text-ink">{w.title}</h3>
            <p class="text-sm text-ink-3">{w.sector}</p>
          </div>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{w.built}</p>
          {w.href && (
            <a href={w.href} target="_blank" rel="noopener" class="btn-ghost mt-auto self-start pt-2">Visit {host(w.href)} <span aria-hidden="true">↗</span></a>
          )}
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .wk-hatch { background: repeating-linear-gradient(135deg, #f1f4f8 0 10px, #e2e8f0 10px 11px); }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .wk-phone { transition: transform var(--dur-ui) var(--ease-out-soft); }
    .group:hover .wk-phone { transform: translateY(-6px); }
  }
</style>
