---
import Wordmark from './Wordmark.astro';
import site from '../content/site.json';
const year = new Date().getFullYear();
---
<footer data-fit="footer" class="border-t border-hairline">
  <div class="container-z grid grid-cols-2 gap-x-6 gap-y-6 py-8 md:grid-cols-[1.4fr_1fr_1.2fr] md:gap-y-10 md:py-20">
    <div class="col-span-2 md:col-span-1">
      <Wordmark />
      <p class="mt-3 max-w-[30ch] text-[0.9375rem] text-ink-2 md:mt-5 md:text-base">{site.tagline}</p>
    </div>
    <nav id="footer-nav" aria-label="Footer">
      <p class="eyebrow mb-2 md:mb-4">Navigate</p>
      <ul class="space-y-1">
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/services">Services</a></li>
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/portfolio">Portfolio</a></li>
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/#about">About</a></li>
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/book">Book a call</a></li>
      </ul>
    </nav>
    <div>
      <p class="eyebrow mb-2 md:mb-4">Legal & contact</p>
      <ul class="space-y-1">
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/privacy">Privacy policy</a></li>
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink-2 hover:text-ink" href="/cookies">Cookie notice</a></li>
        <li><a class="link-u inline-flex min-h-11 items-center max-md:min-h-10 text-ink hover:text-accent-hover" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-hairline">
    <div class="container-z flex flex-col gap-1 py-4 font-mono md:gap-2 md:py-6 text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3 sm:flex-row sm:justify-between">
      <span>{site.legalLine}</span>
      <span>© {year} Zelux</span>
    </div>
  </div>
</footer>
