---
interface Props {
  item: { index: string; image?: string; title: string; sector: string; status: string; friction: string; built: string; outcome: string; isPlaceholder: boolean; href: string | null };
  delay?: number;
  headingLevel?: 'h2' | 'h3';
}
const { item, delay = 0, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const rows = [
  ['The friction', item.friction],
  ['What was built', item.built],
  ['Outcome', item.outcome],
];
---
<article class="panel group flex h-full flex-col overflow-hidden bg-paper transition-colors duration-200 hover:border-hairline-strong" data-reveal style={`--d:${delay}ms`}>
  {item.image && (
    <img src={item.image} alt={`${item.title} website homepage`} class="block aspect-[16/9] w-full border-b border-hairline object-cover object-top" loading="lazy" decoding="async" width="1600" height="1000" />
  )}
  <header class="flex items-start justify-between gap-4 border-b border-hairline p-6">
    <div>
      <Heading class="font-serif text-[1.75rem] leading-[1.1] text-ink">{item.title}</Heading>
      <p class="mt-2 text-sm text-ink-3">{item.sector}</p>
    </div>
    <span
      class:list={[
        'shrink-0 rounded-[2px] border px-2 py-1 font-mono text-[0.625rem] uppercase tracking-[0.12em]',
        item.isPlaceholder ? 'border-hairline text-ink-3' : 'border-hairline-accent text-accent',
      ]}
    >{item.isPlaceholder ? (item.status.startsWith('In build') ? 'In build' : 'Slot reserved') : 'Live'}</span>
  </header>
  <dl class="flex-1 divide-y divide-hairline">
    {rows.map(([k, v]) => (
      <div class="grid gap-1 px-6 py-4">
        <dt class="eyebrow !text-[0.6875rem]">{k}</dt>
        <dd class:list={['text-[0.9375rem] leading-relaxed', item.isPlaceholder ? 'text-ink-3' : 'text-ink-2']}>{v}</dd>
      </div>
    ))}
  </dl>
  <footer class="flex items-center justify-between border-t border-hairline px-6 py-4 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">
    <span>{item.status}</span>
    {item.href && (
      <a href={item.href} target="_blank" rel="noopener" class="link-u inline-flex min-h-10 items-center text-ink hover:text-accent-hover">Visit ↗</a>
    )}
  </footer>
</article>
