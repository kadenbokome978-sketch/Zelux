---
// Projects carousel: real work first (with screenshots), then the in-build slot, then concept builds.
// Native horizontal scroll + scroll-snap, so it works by swipe/trackpad with no JS.
// JS adds: prev/next buttons, counter + progress, arrow keys, mouse drag, and the active-slide state.
// Never auto-advances (WCAG 2.2.2, and Kaden dislikes things that move on their own).
import work from '../content/work.json';
import ConceptPhone from './ConceptPhone.astro';
import SiteShowcase from './SiteShowcase.astro';
import '@fontsource/lilita-one/latin-400.css';

type Work = (typeof work)[number] & { image?: string; imageMobile?: string; desktopLong?: string; mobileLong?: string; frame?: string; bar?: string; barInk?: string };
type Slide =
  | { kind: 'work'; item: Work; theme: Theme }
  | { kind: 'concept'; variant: 'groomer' | 'bakery'; title: string; sector: string; body: string; theme: Theme };
type Theme = { bg: string; ink: string; muted: string; accent: string; line: string };

const themes: Record<string, Theme> = {
  forge: { bg: '#1c1b19', ink: '#f4efe7', muted: '#c9c1b6', accent: '#f08a4b', line: '#3a3732' },
  krapmaps: { bg: '#c42862', ink: '#ffffff', muted: '#fde4ee', accent: '#ffffff', line: '#d9528a' },
  sport: { bg: '#0f172a', ink: '#f1f5f9', muted: '#a5b1c4', accent: '#6ea0ff', line: '#263352' },
  groomer: { bg: '#fbe9e2', ink: '#3b1f2b', muted: '#6b4452', accent: '#a8325a', line: '#ebc3b6' },
  bakery: { bg: '#241e1a', ink: '#f6ecdf', muted: '#cdbfae', accent: '#e8c07a', line: '#3d332c' },
};
const themeFor = (w: Work) => (w.title === 'Forge' ? themes.forge : w.title === 'KrapMaps' ? themes.krapmaps : themes.sport);

const live = (work as Work[]).filter((w) => !w.isPlaceholder);
const reserved = (work as Work[]).filter((w) => w.isPlaceholder);
const slides: Slide[] = [
  ...live.map((item) => ({ kind: 'work' as const, item, theme: themeFor(item) })),
  ...reserved.map((item) => ({ kind: 'work' as const, item, theme: themes.sport })),
  { kind: 'concept', variant: 'groomer', title: 'Muddy Paws', sector: 'Concept · Dog groomer', body: 'Pick a groom, pick a time, get a reminder the day before. Built around one job: filling the diary without phone tag.', theme: themes.groomer },
  { kind: 'concept', variant: 'bakery', title: 'Corner Loaf', sector: 'Concept · Bakery', body: 'Order tonight, collect from 7:30 without queueing. Built around one job: selling tomorrow’s bake before it’s baked.', theme: themes.bakery },
];
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
const badge = (w: Work) => (w.isPlaceholder ? 'In build' : w.status.includes('Co-founded') ? 'Live · Co-founded' : 'Live · Client');
---
<section class="pc" aria-roledescription="carousel" aria-label="Projects" data-carousel>
  <div class="pc-track" data-lenis-prevent tabindex="0" role="region" aria-label="Projects, scroll sideways or use the arrow buttons">
    {slides.map((s, i) => (
      <div
        class="pc-slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}: ${s.kind === 'work' ? s.item.title : s.title}`}
        style={`--bg:${s.theme.bg};--ink:${s.theme.ink};--muted:${s.theme.muted};--ac:${s.theme.accent};--line:${s.theme.line}`}
      >
        <div class="pc-copy">
          <span class="pc-badge">{s.kind === 'work' ? badge(s.item) : 'Concept · not a client'}</span>
          <h3 class:list={['pc-title', s.kind === 'work' && s.item.title === 'KrapMaps' && 'font-krap']}>{s.kind === 'work' ? s.item.title : s.title}</h3>
          <p class="pc-sector">{s.kind === 'work' ? s.item.sector : s.sector}</p>
          {s.kind === 'work' ? (
            <>
              <p class="pc-body">{s.item.friction}</p>
              <p class="pc-body"><strong>{s.item.isPlaceholder ? 'Being built: ' : 'What I built: '}</strong>{s.item.built}</p>
              {s.item.href && (
                <a class="pc-link" href={s.item.href} target="_blank" rel="noopener">Visit {host(s.item.href)} <span aria-hidden="true">↗</span></a>
              )}
            </>
          ) : (
            <p class="pc-body">{s.body}</p>
          )}
        </div>

        <div class="pc-visual">
          {s.kind === 'work' && s.item.desktopLong ? (
            <SiteShowcase title={s.item.title} host={s.item.href ? host(s.item.href) : ''} desktop={s.item.desktopLong} mobile={s.item.mobileLong} frame={s.item.frame!} bar={s.item.bar!} barInk={s.item.barInk!} hinted />
          ) : s.kind === 'work' ? (
            <div class="pc-sheet">
              <p class="pc-sheet-k"><span aria-hidden="true"></span>Build sheet · name shared after launch</p>
              <ul>
                {['Bespoke coaching site', 'Online booking', 'Payments', 'Integrated merch shop'].map((t) => <li>{t}<i>In build</i></li>)}
              </ul>
              <p class="pc-sheet-f">{s.item.status.replace(/^In build · /, '')}</p>
            </div>
          ) : (
            <div class="pc-concept"><ConceptPhone variant={s.variant} /></div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="pc-controls">
    <div class="pc-progress" aria-hidden="true"><span></span></div>
    <p class="pc-count" aria-live="polite"><span class="pc-now">1</span> / {slides.length}</p>
    <div class="pc-buttons">
      <button type="button" class="pc-btn" data-dir="-1" aria-label="Previous project">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 4 6 9l5 5" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </button>
      <button type="button" class="pc-btn" data-dir="1" aria-label="Next project">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 4 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .pc { position: relative; }
  .pc-track {
    display: flex; gap: 1.25rem; margin: 0; padding: 0.25rem 0 0.5rem;
    overflow-x: auto; overscroll-behavior-x: contain;
    scrollbar-width: none; border-radius: var(--radius-card);
  }
  .pc-track::-webkit-scrollbar { display: none; }
    /* Phones: show the laptop view full width (the phone view adds little on a phone) */
  @media (max-width: 640px) { .pc-visual :global(.ss-phone) { display: none; } }
  /* Smaller screens: equal-height cards, copy at the top, screenshots sitting on the bottom edge */
  @media (max-width: 1023px) { .pc-slide { min-height: 0; align-content: space-between; } }
  /* Native snapping only for touch, where a flick has momentum. Mouse/trackpad snapping is done in JS
     (CSS snap made slow trackpad swipes and wheel scrolls spring back to the same slide). */
  @media (pointer: coarse) { .pc-track { scroll-snap-type: x mandatory; } }
  .pc-track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .pc-track.is-dragging { scroll-snap-type: none; scroll-behavior: auto; cursor: grabbing; user-select: none; }
  .pc-track.is-dragging .pc-slide { transition: none; }
  @media (hover: hover) and (pointer: fine) { .pc-track { cursor: grab; } }

  .pc-slide {
    flex: 0 0 88%; scroll-snap-align: start; min-height: 30rem;
    display: grid; gap: 2rem; align-items: center; overflow: hidden;
    padding: 2rem 1.5rem 0; border-radius: calc(var(--radius-card) + 0.5rem);
    background: var(--bg); color: var(--ink);
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }
  @media (min-width: 640px) { .pc-slide { padding: 2.5rem 2.5rem 0; } }
  @media (min-width: 1024px) {
    .pc-slide { flex-basis: 86%; grid-template-columns: 4fr 8fr; gap: 2.5rem; padding: 3rem 0 0 3rem; min-height: 34rem; align-items: start; }
    .pc-slide .pc-visual { align-self: end; }
    .pc-track { -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 56px)), transparent); mask-image: linear-gradient(90deg, transparent, #000 var(--fl, 0px), #000 calc(100% - var(--fr, 56px)), transparent); }
  }
  /* Slides that aren't in focus sit back slightly, so the active one leads. JS adds .is-active. */
  :global(.js) .pc-slide:not(.is-active) { transform: scale(0.96); }

  .pc-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; padding-bottom: 1rem; }
  @media (min-width: 1024px) { .pc-copy { padding-bottom: 3rem; } }
  .pc-badge {
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill); border: 1px solid var(--line);
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
  }
  .pc-title { margin-top: 0.5rem; font-family: var(--font-serif); font-size: clamp(2rem, 3.4vw, 2.75rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 500; }
  .pc-sector { font-size: 0.9375rem; color: var(--muted); }
  .pc-body { max-width: 40ch; font-size: 0.9375rem; line-height: 1.65; color: var(--muted); }
  .pc-body strong { color: var(--ink); font-weight: 600; }
  .pc-link {
    margin-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0 1.1rem;
    border-radius: var(--radius-pill); background: var(--ac); color: var(--bg); font-weight: 600; font-size: 0.9375rem;
    transition: transform var(--dur-ui) var(--ease-out-soft);
  }
  .pc-link:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .pc-link:hover { transform: translateY(-2px); } }

  .pc-visual { align-self: end; display: flex; justify-content: center; min-width: 0; }
  .pc-visual { padding-bottom: 1.5rem; }
  @media (min-width: 1024px) { .pc-visual { padding-right: 2.5rem; padding-bottom: 2.5rem; } }

  .pc-sheet { width: 100%; max-width: 30rem; margin-bottom: 2.5rem; padding: 1.25rem 1.5rem; border-radius: var(--radius-card); background: #16213a; border: 1px solid var(--line); }
  .pc-sheet-k { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .pc-sheet-k span { width: 8px; height: 8px; border-radius: 999px; background: var(--ac); }
  .pc-sheet ul { margin: 1rem 0 0; padding: 0; list-style: none; }
  .pc-sheet li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid var(--line); font-weight: 600; }
  .pc-sheet li i { font-style: normal; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ac); }
  @media (max-width: 1023px) { .pc-sheet { margin-bottom: 1.25rem; padding: 1rem 1.1rem; } .pc-sheet li { padding: 0.6rem 0; font-size: 0.9375rem; } }
  .pc-sheet-f { padding-top: 0.8rem; border-top: 1px solid var(--line); font-size: 0.875rem; color: var(--muted); }
  .pc-concept { margin-bottom: -6rem; }
  .pc-concept :global(figcaption) { display: none; }

  .pc-controls { margin-top: 1.25rem; display: flex; align-items: center; gap: 1rem; }
  .pc-progress { position: relative; flex: 1; height: 2px; border-radius: 2px; background: var(--color-hairline); overflow: hidden; }
  .pc-progress span { position: absolute; inset: 0; background: var(--color-ink); transform-origin: left; transform: scaleX(var(--p, 0.2)); transition: transform var(--dur-ui) var(--ease-out-soft); }
  .pc-count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  .pc-buttons { display: flex; gap: 0.5rem; }
  .pc-btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px;
    border: 1px solid var(--color-hairline-strong); background: var(--color-paper); color: var(--color-ink);
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast), transform var(--dur-ui) var(--ease-out-soft);
  }
  .pc-btn:active:not(:disabled) { transform: scale(0.94); }
  .pc-btn:disabled { opacity: 0.4; cursor: default; }
  .pc-btn[data-dir='1']:not(:disabled) { background: var(--color-ink); color: var(--color-canvas); border-color: var(--color-ink); }
  @media (hover: hover) and (pointer: fine) { .pc-btn[data-dir='-1']:not(:disabled):hover { border-color: var(--color-ink); } .pc-btn[data-dir='1']:not(:disabled):hover { background: var(--color-accent); border-color: var(--color-accent); } }
  :global(html:not(.js)) .pc-buttons, :global(html:not(.js)) .pc-count { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pc-track')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.pc-slide'));
    const now = root.querySelector('.pc-now');
    const bar = root.querySelector<HTMLElement>('.pc-progress span');
    const [prev, next] = Array.from(root.querySelectorAll<HTMLButtonElement>('.pc-btn'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dragging = false;
    let current = 0; // slide the controls point at (updated straight away on click, synced when scrolling stops)

    const paintControls = (i: number) => {
      if (now) now.textContent = String(i + 1);
      bar?.style.setProperty('--p', String((i + 1) / slides.length));
      prev.disabled = i <= 0;
      next.disabled = i >= slides.length - 1;
      // Edge fades only where there's another slide to see
      track.style.setProperty('--fl', i > 0 ? '56px' : '0px');
      track.style.setProperty('--fr', i < slides.length - 1 ? '56px' : '0px');
    };
    const paintActive = (i: number) => slides.forEach((s, j) => s.classList.toggle('is-active', j === i));

    // Which slide is most visible, measured against the track itself (works at both ends).
    const visible = new Map<Element, number>();
    const mostVisible = () => {
      let best = current, ratio = -1;
      slides.forEach((s, j) => { const r = visible.get(s) ?? 0; if (r > ratio + 0.01) { ratio = r; best = j; } });
      return best;
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => visible.set(e.target, e.intersectionRatio));
    }, { root: track, threshold: [0, 0.25, 0.5, 0.75, 1] });
    slides.forEach((s) => io.observe(s));

    // Only settle the "active" look once scrolling stops, so slides don't twitch mid-swipe.
    let settleTimer = 0;
    let programmatic = false;
    let lastLeft = track.scrollLeft;
    const coarse = matchMedia('(pointer: coarse)');
    const offsetOf = (i: number) => Math.min(slides[i].offsetLeft - slides[0].offsetLeft, track.scrollWidth - track.clientWidth);
    const settle = () => {
      const left = track.scrollLeft;
      if (!coarse.matches && !programmatic && !dragging) {
        // Snap in the direction of travel once the user has nudged ~12% of a slide.
        const dir = Math.sign(left - lastLeft);
        const width = slides[0].offsetWidth;
        const from = offsetOf(current);
        let target = current;
        if (Math.abs(left - from) > width * 0.12) {
          let best = current, dist = Infinity;
          slides.forEach((_, j) => { const d = Math.abs(offsetOf(j) - left); if (d < dist) { dist = d; best = j; } });
          target = best === current ? current + (dir || Math.sign(left - from)) : best;
        }
        target = Math.max(0, Math.min(slides.length - 1, target));
        if (Math.abs(offsetOf(target) - left) > 2) { go(target); return; }
      }
      programmatic = false;
      current = mostVisible();
      paintControls(current);
      paintActive(current);
      lastLeft = track.scrollLeft;
    };
    const onScroll = () => { clearTimeout(settleTimer); settleTimer = window.setTimeout(settle, 140); };
    track.addEventListener('scroll', onScroll, { passive: true });
    if ('onscrollend' in window) track.addEventListener('scrollend', () => { clearTimeout(settleTimer); settle(); });

    const go = (i: number) => {
      current = Math.max(0, Math.min(slides.length - 1, i));
      paintControls(current);
      paintActive(current);
      programmatic = true;
      lastLeft = offsetOf(current);
      track.scrollTo({ left: offsetOf(current), behavior: reduce ? 'auto' : 'smooth' });
      // if already there, no scroll event fires: clear the flag ourselves
      if (Math.abs(track.scrollLeft - offsetOf(current)) < 2) programmatic = false;
    };
    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    track.addEventListener('keydown', (e) => {
      if (e.target !== track) return; // let links inside slides keep their own keys
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1); }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });

    // Mouse drag (touch and trackpads scroll natively). Pointer capture keeps the drag even off the track.
    let startX = 0, startLeft = 0, moved = false, swallow = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
    });
    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) { moved = true; track.setPointerCapture(e.pointerId); track.classList.add('is-dragging'); }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (!moved) return;
      track.classList.remove('is-dragging');
      if (track.hasPointerCapture(e.pointerId)) track.releasePointerCapture(e.pointerId);
      lastLeft = startLeft; // so settle() snaps in the drag direction
      settle();
      swallow = true; // the click that ends a drag shouldn't open a link
      setTimeout(() => (swallow = false), 0);
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('click', (e) => { if (swallow) { e.preventDefault(); e.stopPropagation(); } }, true);
    track.addEventListener('dragstart', (e) => e.preventDefault());

    // Keep the current slide in place if the window is resized.
    let resizeTimer = 0;
    addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(() => go(current), 150); });

    paintControls(0);
    paintActive(0);
  });
</script>
