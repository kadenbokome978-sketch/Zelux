---
// Projects carousel: real work first (with screenshots), then the in-build slot, then concept builds.
// Native horizontal scroll + scroll-snap, so it works by swipe/trackpad with no JS.
// JS adds: prev/next buttons, counter + progress, arrow keys, mouse drag, and the active-slide state.
// Never auto-advances (WCAG 2.2.2, and Kaden dislikes things that move on their own).
import work from '../content/work.json';
import ConceptPhone from './ConceptPhone.astro';

type Work = (typeof work)[number] & { image?: string; imageMobile?: string; theme?: string };
type Slide =
  | { kind: 'work'; item: Work; theme: Theme }
  | { kind: 'concept'; variant: 'groomer' | 'bakery'; title: string; sector: string; body: string; theme: Theme };
type Theme = { bg: string; ink: string; muted: string; accent: string; line: string };

const themes: Record<string, Theme> = {
  forge: { bg: '#1c1b19', ink: '#f4efe7', muted: '#c9c1b6', accent: '#f08a4b', line: '#3a3732' },
  krapmaps: { bg: '#ee4a86', ink: '#22040f', muted: '#33081b', accent: '#2a0614', line: '#f27aa5' },
  sport: { bg: '#0f172a', ink: '#f1f5f9', muted: '#a5b1c4', accent: '#6ea0ff', line: '#263352' },
  groomer: { bg: '#fbe9e2', ink: '#3b1f2b', muted: '#6b4452', accent: '#a8325a', line: '#ebc3b6' },
  bakery: { bg: '#241e1a', ink: '#f6ecdf', muted: '#cdbfae', accent: '#e8c07a', line: '#3d332c' },
};
const themeFor = (w: Work) => (w.title === 'Forge' ? themes.forge : w.title === 'KrapMaps' ? themes.krapmaps : themes.sport);

const live = (work as Work[]).filter((w) => !w.isPlaceholder);
const reserved = (work as Work[]).filter((w) => w.isPlaceholder);
const slides: Slide[] = [
  ...live.map((item) => ({ kind: 'work' as const, item, theme: themeFor(item) })),
  ...reserved.map((item) => ({ kind: 'work' as const, item, theme: themes.sport })),
  { kind: 'concept', variant: 'groomer', title: 'Muddy Paws', sector: 'Concept · Dog groomer', body: 'Pick a groom, pick a time, get a reminder the day before. Built around one job: filling the diary without phone tag.', theme: themes.groomer },
  { kind: 'concept', variant: 'bakery', title: 'Corner Loaf', sector: 'Concept · Bakery', body: 'Order tonight, collect from 7:30 without queueing. Built around one job: selling tomorrow’s bake before it’s baked.', theme: themes.bakery },
];
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
const badge = (w: Work) => (w.isPlaceholder ? 'In build' : w.status.includes('Co-founded') ? 'Live · Co-founded' : 'Live · Client');
---
<section class="pc" aria-roledescription="carousel" aria-label="Projects" data-carousel>
  <div class="pc-track" tabindex="0" role="region" aria-label="Projects, scroll sideways or use the arrow buttons">
    {slides.map((s, i) => (
      <div
        class="pc-slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}: ${s.kind === 'work' ? s.item.title : s.title}`}
        style={`--bg:${s.theme.bg};--ink:${s.theme.ink};--muted:${s.theme.muted};--ac:${s.theme.accent};--line:${s.theme.line}`}
      >
        <div class="pc-copy">
          <span class="pc-badge">{s.kind === 'work' ? badge(s.item) : 'Concept · not a client'}</span>
          <h3 class="pc-title">{s.kind === 'work' ? s.item.title : s.title}</h3>
          <p class="pc-sector">{s.kind === 'work' ? s.item.sector : s.sector}</p>
          {s.kind === 'work' ? (
            <>
              <p class="pc-body">{s.item.friction}</p>
              <p class="pc-body"><strong>{s.item.isPlaceholder ? 'Being built: ' : 'What I built: '}</strong>{s.item.built}</p>
              {s.item.href && (
                <a class="pc-link" href={s.item.href} target="_blank" rel="noopener">Visit {host(s.item.href)} <span aria-hidden="true">↗</span></a>
              )}
            </>
          ) : (
            <p class="pc-body">{s.body}</p>
          )}
        </div>

        <div class="pc-visual">
          {s.kind === 'work' && s.item.image ? (
            <div class="pc-device">
              <div class="pc-browser">
                <div class="pc-bar" aria-hidden="true"><i></i><i></i><i></i><span>{s.item.href && host(s.item.href)}</span></div>
                <img src={s.item.image} alt={`${s.item.title} website on a laptop`} loading="lazy" decoding="async" width="1600" height="1000" />
              </div>
              {s.item.imageMobile && (
                <img class="pc-phone" src={s.item.imageMobile} alt={`${s.item.title} website on a phone`} loading="lazy" decoding="async" width="600" height="1298" />
              )}
            </div>
          ) : s.kind === 'work' ? (
            <div class="pc-soon" aria-hidden="true">
              <span class="pc-soon-ring"></span>
              <span class="pc-soon-text">Preview after launch</span>
            </div>
          ) : (
            <div class="pc-concept"><ConceptPhone variant={s.variant} /></div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="pc-controls">
    <div class="pc-progress" aria-hidden="true"><span></span></div>
    <p class="pc-count" aria-live="polite"><span class="pc-now">1</span> / {slides.length}</p>
    <div class="pc-buttons">
      <button type="button" class="pc-btn" data-dir="-1" aria-label="Previous project">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 4 6 9l5 5" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </button>
      <button type="button" class="pc-btn" data-dir="1" aria-label="Next project">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 4 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .pc { position: relative; }
  .pc-track {
    display: flex; gap: 1.25rem; margin: 0; padding: 0.25rem 0 0.5rem;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    scrollbar-width: none; border-radius: var(--radius-card);
  }
  .pc-track::-webkit-scrollbar { display: none; }
  .pc-track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .pc-track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  @media (hover: hover) and (pointer: fine) { .pc-track { cursor: grab; } }

  .pc-slide {
    flex: 0 0 88%; scroll-snap-align: start; min-height: 30rem;
    display: grid; gap: 2rem; align-items: center; overflow: hidden;
    padding: 2rem 1.5rem 0; border-radius: calc(var(--radius-card) + 0.5rem);
    background: var(--bg); color: var(--ink);
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }
  @media (min-width: 640px) { .pc-slide { padding: 2.5rem 2.5rem 0; } }
  @media (min-width: 1024px) {
    .pc-slide { flex-basis: 84%; grid-template-columns: 5fr 7fr; padding: 3rem 0 0 3rem; min-height: 32rem; }
  }
  /* Slides that aren't in focus sit back slightly, so the active one leads. JS adds .is-active. */
  :global(.js) .pc-slide:not(.is-active) { transform: scale(0.96); }

  .pc-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; padding-bottom: 1rem; }
  @media (min-width: 1024px) { .pc-copy { padding-bottom: 3rem; } }
  .pc-badge {
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill); border: 1px solid var(--line);
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink);
  }
  .pc-title { margin-top: 0.5rem; font-family: var(--font-serif); font-size: clamp(2rem, 3.4vw, 2.75rem); line-height: 1.02; letter-spacing: -0.03em; font-weight: 500; }
  .pc-sector { font-size: 0.9375rem; color: var(--muted); }
  .pc-body { max-width: 44ch; font-size: 0.9375rem; line-height: 1.65; color: var(--muted); }
  .pc-body strong { color: var(--ink); font-weight: 600; }
  .pc-link {
    margin-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0 1.1rem;
    border-radius: var(--radius-pill); background: var(--ac); color: var(--bg); font-weight: 600; font-size: 0.9375rem;
    transition: transform var(--dur-ui) var(--ease-out-soft);
  }
  .pc-link:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .pc-link:hover { transform: translateY(-2px); } }

  .pc-visual { align-self: end; display: flex; justify-content: center; }
  .pc-device { position: relative; width: 100%; padding-right: 14%; }
  @media (min-width: 1024px) { .pc-device { padding-right: 18%; margin-right: -1px; } }
  .pc-browser {
    overflow: hidden; border-radius: 14px 14px 0 0; background: #fcfdff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .pc-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #eef2f7; }
  .pc-bar i { width: 8px; height: 8px; border-radius: 999px; background: #c5cdd9; }
  .pc-bar span { margin-left: 8px; font-family: var(--font-mono); font-size: 0.625rem; color: #5b677a; }
  .pc-browser img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .pc-phone {
    position: absolute; right: 0; bottom: 0; width: 30%; max-width: 190px; min-width: 92px;
    border: 6px solid #0b1120; border-bottom: 0; border-radius: 22px 22px 0 0; background: #0b1120;
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }
  :global(.js) .pc-slide:not(.is-active) .pc-phone { transform: translateY(18px); }

  .pc-soon { position: relative; display: grid; place-items: center; width: 100%; height: 18rem; margin-bottom: 2rem; }
  .pc-soon-ring { position: absolute; width: 14rem; height: 14rem; border-radius: 999px; border: 1px dashed var(--line); }
  .pc-soon-text { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .pc-concept { margin-bottom: -6rem; }
  .pc-concept :global(figcaption) { display: none; }

  .pc-controls { margin-top: 1.25rem; display: flex; align-items: center; gap: 1rem; }
  .pc-progress { position: relative; flex: 1; height: 2px; border-radius: 2px; background: var(--color-hairline); overflow: hidden; }
  .pc-progress span { position: absolute; inset: 0; background: var(--color-ink); transform-origin: left; transform: scaleX(var(--p, 0.2)); transition: transform var(--dur-ui) var(--ease-out-soft); }
  .pc-count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  .pc-buttons { display: flex; gap: 0.5rem; }
  .pc-btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px;
    border: 1px solid var(--color-hairline-strong); background: var(--color-paper); color: var(--color-ink);
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast), transform var(--dur-ui) var(--ease-out-soft);
  }
  .pc-btn:active:not(:disabled) { transform: scale(0.94); }
  .pc-btn:disabled { opacity: 0.4; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .pc-btn:not(:disabled):hover { background: var(--color-ink); color: var(--color-canvas); border-color: var(--color-ink); } }
  :global(html:not(.js)) .pc-buttons, :global(html:not(.js)) .pc-count { display: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pc-track')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.pc-slide'));
    const now = root.querySelector('.pc-now');
    const bar = root.querySelector<HTMLElement>('.pc-progress span');
    const [prev, next] = Array.from(root.querySelectorAll<HTMLButtonElement>('.pc-btn'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;

    const setActive = (i: number) => {
      active = i;
      slides.forEach((s, j) => s.classList.toggle('is-active', j === i));
      if (now) now.textContent = String(i + 1);
      bar?.style.setProperty('--p', String((i + 1) / slides.length));
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
    };
    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    };

    // Which slide is in front: the one closest to the track's left edge.
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const x = track.scrollLeft;
        let best = 0, dist = Infinity;
        slides.forEach((s, j) => { const d = Math.abs(s.offsetLeft - track.offsetLeft - x); if (d < dist) { dist = d; best = j; } });
        if (best !== active) setActive(best);
      });
    }, { passive: true });

    prev.addEventListener('click', () => go(active - 1));
    next.addEventListener('click', () => go(active + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(active + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(active - 1); }
    });

    // Mouse drag (touch and trackpads already scroll natively).
    let startX = 0, startLeft = 0, dragging = false, moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) { moved = true; track.classList.add('is-dragging'); }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        track.classList.remove('is-dragging');
        go(active);
        // swallow the click that ends a drag so links don't open by accident
        track.addEventListener('click', (ev) => { ev.preventDefault(); ev.stopPropagation(); }, { capture: true, once: true });
      }
    });
    track.addEventListener('dragstart', (e) => e.preventDefault());

    setActive(0);
  });
</script>
