---
// A phone mockup of an example client site, built in HTML/CSS (no images, no stock).
// Every concept is fictional and labelled as such on the page. Not a client, not proof.
interface Props {
  variant: 'plumber' | 'groomer' | 'bakery';
  size?: 'lg' | 'md' | 'sm';
  toast?: boolean;
}
const { variant, size = 'md', toast = false } = Astro.props;

const concepts = {
  plumber: {
    label: 'Concept · plumber',
    brand: 'Brookfield',
    brandSub: 'Plumbing & Heating',
    bg: '#0e3b2f', ink: '#f3f1e7', accent: '#f2b33d', accentInk: '#1d1a10', soft: '#15493b', line: '#2a5a4b',
    kicker: 'Gas Safe · Same-week visits',
    headline: 'Boiler playing up? Book a visit in two taps.',
    cta: 'Book a visit',
    listTitle: 'Next free slots',
    items: [['Tue', '9:00'], ['Tue', '13:30'], ['Wed', '8:00'], ['Thu', '15:00']],
    extra: [['Boiler service', 'from £85'], ['Leak or repair', 'from £60']],
    foot: 'Fixed prices shown before you book',
    toastTitle: 'New booking',
    toastBody: 'Boiler service · Tue 9:00',
  },
  groomer: {
    label: 'Concept · groomer',
    brand: 'Muddy Paws',
    brandSub: 'Grooming studio',
    bg: '#fbe9e2', ink: '#3b1f2b', accent: '#a8325a', accentInk: '#fff7f9', soft: '#f6d7cc', line: '#ebc3b6',
    kicker: 'Small, calm, one dog at a time',
    headline: 'Pick a groom, pick a time, done.',
    cta: 'Book a groom',
    listTitle: 'Choose a groom',
    items: [['Bath & tidy', '45 min'], ['Full groom', '2 hrs'], ['Puppy intro', '30 min']],
    foot: 'Reminder text sent the day before',
    toastTitle: 'Reminder sent',
    toastBody: 'Biscuit · Full groom · Fri 10:00',
  },
  bakery: {
    label: 'Concept · bakery',
    brand: 'Corner Loaf',
    brandSub: 'Bakery & coffee',
    bg: '#1f1a17', ink: '#f6ecdf', accent: '#e8c07a', accentInk: '#241c12', soft: '#2b241f', line: '#3d332c',
    kicker: 'Order by 8pm, collect from 7:30am',
    headline: 'Tomorrow’s bread, ordered tonight.',
    cta: 'Order for collection',
    listTitle: 'Tomorrow’s bake',
    items: [['Sourdough', '£4.80'], ['Seeded rye', '£4.20'], ['Cardamom bun', '£3.10']],
    foot: 'Pay online · Collect without queueing',
    toastTitle: 'Order ready',
    toastBody: 'Collect from 7:30 · #A12',
  },
} as const;
const c = concepts[variant];
const w = size === 'lg' ? 300 : size === 'sm' ? 216 : 260;
---
<figure class="concept" style={`--w:${w}px`} aria-label={`${c.label}. Example design, not a real client.`}>
  <div
    class="phone"
    style={`--bg:${c.bg};--ink:${c.ink};--ac:${c.accent};--ac-ink:${c.accentInk};--soft:${c.soft};--line:${c.line}`}
    aria-hidden="true"
  >
    <div class="screen">
      <div class="notch"></div>
      <div class="bar">
        <div class="logo"><span class="mark"></span><span><b>{c.brand}</b><i>{c.brandSub}</i></span></div>
        <span class="menu"><span></span><span></span></span>
      </div>
      <div class="hero">
        <p class="kicker">{c.kicker}</p>
        <p class="headline">{c.headline}</p>
        <span class="cta">{c.cta} →</span>
      </div>
      <div class="list">
        <p class="list-title">{c.listTitle}</p>
        <div class:list={['items', variant === 'plumber' && 'slots']}>
          {c.items.map(([a, b], i) => (
            <span class:list={['item', i === 0 && 'picked']}><b>{a}</b><i>{b}</i></span>
          ))}
        </div>
      </div>
      {'extra' in c && (
        <div class="list">
          <p class="list-title">Prices</p>
          <div class="items">
            {c.extra.map(([a, b]) => <span class="item"><b>{a}</b><i>{b}</i></span>)}
          </div>
        </div>
      )}
      <p class="foot">{c.foot}</p>
      {toast && (
        <div class="toast">
          <span class="dot"></span>
          <span><b>{c.toastTitle}</b><i>{c.toastBody}</i></span>
        </div>
      )}
    </div>
  </div>
  <figcaption>{c.label}<span>Not a client</span></figcaption>
</figure>

<style>
  .concept { width: var(--w); margin: 0; }
  .phone {
    width: var(--w); aspect-ratio: 9 / 17.5; padding: 9px;
    border-radius: 42px; background: #0b1120;
    box-shadow: inset 0 0 0 1.5px #334155;
  }
  .screen {
    position: relative; height: 100%; overflow: hidden; border-radius: 34px;
    background: var(--bg); color: var(--ink);
    display: flex; flex-direction: column; gap: 14px; padding: 40px 18px 18px;
    font-family: var(--font-sans);
  }
  .notch { position: absolute; top: 10px; left: 50%; width: 78px; height: 22px; margin-left: -39px; border-radius: 999px; background: #0b1120; }
  .bar { display: flex; align-items: center; justify-content: space-between; }
  .logo { display: flex; align-items: center; gap: 8px; line-height: 1.05; }
  .logo b { display: block; font-family: var(--font-serif); font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .logo i { display: block; font-style: normal; font-size: 9.5px; opacity: 0.75; }
  .mark { width: 22px; height: 22px; border-radius: 7px; background: var(--ac); }
  .menu { display: grid; gap: 4px; }
  .menu span { display: block; width: 16px; height: 1.5px; background: currentColor; }
  .hero { display: grid; gap: 8px; padding: 14px; border-radius: 16px; background: var(--soft); }
  .kicker { margin: 0; font-size: 9.5px; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.8; }
  .headline { margin: 0; font-family: var(--font-serif); font-size: calc(var(--w) * 0.083); line-height: 1.05; font-weight: 600; letter-spacing: -0.03em; text-wrap: balance; }
  .cta { justify-self: start; margin-top: 4px; padding: 8px 12px; border-radius: 999px; background: var(--ac); color: var(--ac-ink); font-size: 11.5px; font-weight: 600; }
  .list { display: grid; gap: 8px; }
  .list-title { margin: 0; font-size: 10.5px; font-weight: 600; opacity: 0.85; }
  .items { display: grid; gap: 6px; }
  .items.slots { grid-template-columns: 1fr 1fr; }
  .item { display: flex; justify-content: space-between; align-items: baseline; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--line); font-size: 11.5px; }
  .item b { font-weight: 600; }
  .item i { font-style: normal; opacity: 0.75; }
  .item.picked { background: var(--ac); border-color: var(--ac); color: var(--ac-ink); }
  .item.picked i { opacity: 1; }
  .foot { margin: auto 0 0; font-size: 10px; opacity: 0.7; text-align: center; }
  .toast {
    position: absolute; left: 12px; right: 12px; top: 40px;
    display: flex; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 16px;
    background: rgb(252 253 255 / 0.96); color: #0f172a; font-size: 11px; line-height: 1.25;
    box-shadow: 0 10px 30px -12px rgb(15 23 42 / 0.45);
  }
  .toast b { display: block; font-weight: 600; }
  .toast i { display: block; font-style: normal; color: #475569; }
  .toast .dot { width: 26px; height: 26px; flex: none; border-radius: 8px; background: #16a34a; box-shadow: inset 0 0 0 7px #16a34a, inset 0 0 0 9px #fff; }
  figcaption { margin-top: 12px; text-align: center; white-space: nowrap; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3); }
  figcaption span { display: block; margin-top: 2px; color: var(--color-ink-3); }

  /* The booking alert drops in shortly after the page loads. Static when motion is reduced. */
  @media (prefers-reduced-motion: no-preference) {
    .toast { animation: toast-in 520ms var(--ease-out-soft) 1.4s both; }
  }
  @keyframes toast-in { from { opacity: 0; transform: translateY(-14px) scale(0.97); } }
</style>
