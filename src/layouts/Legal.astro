---
import Base from './Base.astro';
interface Props { title: string; description: string; heading: string; updated: string }
const { title, description, heading, updated } = Astro.props;
---
<Base title={title} description={description}>
  <section class="container-z pb-24 pt-20 md:pb-32 md:pt-28">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-3">
        <p class="eyebrow md:sticky md:top-28">Legal · Updated {updated}</p>
      </div>
      <div class="md:col-span-9">
        <h1 class="h-section">{heading}</h1>
        <div class="prose-z mt-10">
          <slot />
        </div>
      </div>
    </div>
  </section>
</Base>
