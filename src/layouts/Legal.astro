---
import Base from './Base.astro';
interface Props { title: string; description: string; heading: string; updated: string }
const { title, description, heading, updated } = Astro.props;
---
<Base title={title} description={description}>
  <section class="container-z pb-20 pt-14 md:pb-28 md:pt-20">
    <div>
      <div>
        <p class="eyebrow">Legal · Updated <span class="whitespace-nowrap">{updated}</span></p>
        <h1 class="h-section mt-5">{heading}</h1>
        <div class="prose-z mt-10">
          <slot />
        </div>
      </div>
    </div>
  </section>
</Base>
